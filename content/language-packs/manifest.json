{
  "schema_version": 1,
  "description": "AIC language packs in core-assets. Catalogs stay under locales/, locales-ui/, and i18n-native/. product tags select which trees an installer harvests.",
  "products": [
    {
      "id": "aic-server",
      "areas": [
        "content/locales/<tag>/",
        "content/locales-ui/<tag>/"
      ],
      "ships_with": "AIC Server MSI / admin SPA"
    },
    {
      "id": "shared-gui-chrome",
      "areas": [
        "content/i18n-native/gui/<tag>/chrome.json"
      ],
      "ships_with": "Every Win32/Tauri configurator"
    },
    {
      "id": "aic-server-configurator",
      "areas": [
        "content/i18n-native/gui/<tag>/server_configurator.json"
      ],
      "ships_with": "Server configurator Win32 + Tauri + CLI"
    },
    {
      "id": "aic-agent",
      "areas": [
        "content/i18n-native/apps/pim-offline-agent/<tag>/"
      ],
      "ships_with": "Endpoint agent"
    },
    {
      "id": "aic-agent-configurator",
      "areas": [
        "content/i18n-native/gui/<tag>/agent_configurator.json"
      ],
      "ships_with": "Agent configurator (native packs not complete yet)"
    },
    {
      "id": "aic-jump-configurator",
      "areas": [
        "content/i18n-native/apps/pim-jump-server/<tag>/",
        "content/i18n-native/gui/<tag>/jump_configurator.json",
        "content/i18n-native/gui/<tag>/chrome.json"
      ],
      "ships_with": "Jump Server MSI (product + shared-gui-chrome)"
    },
    {
      "id": "aic-db-mgmt-configurator",
      "areas": [
        "content/i18n-native/apps/pim-db-mgmt-agent/<tag>/",
        "content/i18n-native/gui/<tag>/db_mgmt_configurator.json",
        "content/i18n-native/gui/<tag>/chrome.json"
      ],
      "ships_with": "DB Management Agent MSI (product + shared-gui-chrome)"
    },
    {
      "id": "aic-recording-agent",
      "areas": [
        "content/i18n-native/apps/pim-offline-recording-agent/<tag>/"
      ],
      "ships_with": "Recording agent"
    }
  ],
  "packs": [
