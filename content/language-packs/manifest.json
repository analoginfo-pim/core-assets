  "rules": {
    "en_gb_not_alias": true,
    "zh_tw_not_converted_from_zh_hans": true,
    "no_english_fill_for_missing_keys": true,
    "no_cyberark_missing_key_english_fallback": true,
    "us_english_always_installed": true,
    "official_cmmc_80053_bodies_stay_english": true,
    "no_licensed_iso27001_body_translation": true
  }
