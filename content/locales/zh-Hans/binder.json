  "profiles": {
    "cmmc": {
      "label": {
        "text": "CMMC",
        "source_sha256": "0ecd57c0c4a4e075944d57d01aedc7c6e7cd733d982f0aad4bf53678ab1a0fe9"
      },
      "explanation": {
        "text": "CMMC（32 CFR 170）是基于 NIST SP 800-171（以及在级别 3 选定的 NIST SP 800-172 增强要求）的国防部评估打包。级别 1 覆盖基本 FCI 防护；级别 2 对齐至 CUI 的 110 项 800-171 Rev 2 实践；级别 3 增加增强的 800-172 要求。CMMC 不取代 NIST SP 800-53 Rev 5 控制设计底线 — 它为 C3PAO / 国防部审查打包评估证据。",
        "source_sha256": "cceb486611a80d28672aafc4ca0f2e48a4052220b013af9c3078e586916ab1d3"
      }
    },
    "nist_800_171": {
      "label": {
        "text": "NIST SP 800-171",
        "source_sha256": "f4856a2f7a01e12a623398b039c99476d5205d6791886eca5cb0357ebaeb3953"
      },
      "explanation": {
        "text": "NIST SP 800-171 Rev 2 在 14 个族中定义了 110 项安全要求，用于在非联邦系统中保护 CUI。级别 1 打包侧重基本 / 面向 FCI 的实践；级别 2 是常与 CMMC 级别 2 配对的完整 110 实践集；级别 3 框架可能引用额外增强期望。产品控制设计仍遵循 NIST SP 800-53 Rev 5 底线；800-171 是该底线上的评估打包。",
        "source_sha256": "8c49b236b9e9a09787b9b81bb1a4752d606cea1724793135b9b6b8ad31f5f42f"
      }
    },
    "nist_800_172": {
      "label": {
        "text": "NIST SP 800-172",
        "source_sha256": "d8c82bfcd76ff4b5cf43ca875aa422768965b436af851f30c37854a6a70f6eb0"
      },
      "explanation": {
        "text": "NIST SP 800-172（2021 年 2 月）在 800-171 之外增加 35 项增强安全要求。CMMC 级别 3 选择其中子集。此打包视图强调增强要求以及底层 800-171 / CMMC 证据。未证明的增强声明保持为缺口或未知 — 在此切换会筛选/重新映射范围；它不会发明新的主机证据。",
        "source_sha256": "6a040a57641ec670d2c9dc3c1f3a771fc2c1ecf7adb60bde6070e360b401f98e"
      }
    },
    "nist_800_53": {
      "label": {
        "text": "NIST SP 800-53",
        "source_sha256": "2c8cae03f30fab0b8a30bbea566d264a76f93797a963653e6711af0d98348719"
      },
      "explanation": {
        "text": "NIST SP 800-53 Rev 5 是本产品的控制设计底线（中等基线，在选定处为高）。控制族（AC、AU、CM、IA、SC、SI 等）组织目录。其他处的 CMMC / 800-171 / 800-172 行是复用同一飞地证据的评估打包覆盖层 — 它们不是 800-53 底线的更薄替代。",
        "source_sha256": "3db2e0c83b144ffe6fd7d4c3b5693439fefe46ef0c3fb867f2a5973362767e6c"
      }
    },
    "level_1": {
