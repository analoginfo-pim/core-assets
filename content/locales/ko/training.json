    "welcome": {
      "subject": {
        "text": "훈련을 배정받았습니다",
        "source_sha256": "6644e8dc01cf72c8ff8abfd33a0ce358622263a477748a552f9e0ea4b141b2d1"
      },
      "body": {
        "text": "안녕하세요 {full_name}. 귀하에게 {program_name}이 할당되었습니다. {due_date}까지 완료해주세요. 이 메시지는 우리가 당신에게 읽으라고 요청한 내용을 기록합니다. 등급이 아닙니다. 도움이 필요하면 관리자에게 문의하세요.",
        "source_sha256": "9062937cc546e75561cb60cb064ea90b8cc96dd8672deea1d49ef69d891226b8"
      }
    },
    "reminder": {
      "subject": {
