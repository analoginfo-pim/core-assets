  "iga": {
    "customer_entra_ad": {
      "label": {
        "text": "AD / ספרייה חיצונית בניהול לקוחות",
        "source_sha256": "24052b3cd2b9c49b52aa127ab1cae82f0ac32408769b06b741e22fbb03675579"
      },
      "boilerplate": {
        "text": "ההקצאה ומחזור החיים של זהות עבור לקוח זה מטופלים ב-Active Directory המנוהלת על ידי הלקוח ו/או בספריית OIDC חיצונית מחוץ ל-AIC Server. מצטרף/מעביר/עוזב, חברות בקבוצה והקצאה מונעת משאבי אנוש הם בבעלות צוות IdP של הלקוח. קלסר זה מצטט רק הקשר של גישה ונקודת קצה; הוא אינו מפעיל מחבר IGA.",
        "source_sha256": "66a7a56ba5120ea0b3e86fb772cdf4f339bded4c19e7136ce9a79934fb33e35f"
      }
    },
    "msp_run_iga": {
      "label": {
        "text": "IGA בהפעלת MSP",
        "source_sha256": "4741f2538fb6268ae20a89e343ce1b02747d62ad97f1c9be729121e057336b66"
      },
      "boilerplate": {
        "text": "MSP מפעיל את מחזור החיים של IGA / זהות של לקוח זה (חבר-מעביר-עוזב, סקירות גישה והקצאה קשורה) מחוץ לשרת AIC. ה-MSP מתעד נהלים וראיות תחת כלי ה-IGA הנבחר של הלקוח. AIC Server אינו מספק IGA ארגוני בכרטיס מוצר זה.",
        "source_sha256": "cc86925fa5196a459e44845ef891857faeb529d0ad2f3ef5f392071f256cc5a6"
      }
    },
    "deferred_robert": {
      "label": {
        "text": "נדחה לשיתוף פעולה עתידי של זהות-מחזור חיים",
        "source_sha256": "54eec9b34e79d40337e48ef5714d4b9af1c3b5f3df38579bf3dda59e3bd6ae0f"
      },
      "boilerplate": {
        "text": "אספקת IGA / מחזור חיים ארגונית אינה בגדר כרטיס מוצר זה של שרת AIC. הוא מיועד לשיתוף פעולה עתידי עם ליבת מחזור החיים של הזהות. עד שהעבודה הזו תנחת, לקוח זה מתעד כיצד הטיפול בהקצאה מחוץ למוצר זה (IdP, MSP או שותף). אל תתייחס לסעיף זה כראיה לכך ש-AIC מספקת IGA היום.",
        "source_sha256": "5ecf29b1c023ac4c8e103ba2e357ae959b475ee54198e512508b069ba0ca2e34"
      }
    },
    "partner_netthunder": {
      "label": {
        "text": "שותף / הקצאה מקומית",
        "source_sha256": "6fe11b2f0579ea2d9f9433cce802157eeecb3b55badc2c23e4403d555d19e44b"
      },
      "boilerplate": {
        "text": "הקצאת זהות מקומית או המופעלת על ידי שותף חלה על לקוח זה. השותף הנקוב מפעיל אינטגרציות של ספריות/הקצאה. שרת AIC אינו מספק IGA ארגוני בכרטיס מוצר זה; תאר כאן את התהליך המנוהל על ידי שותף ומיקום ההוכחות.",
        "source_sha256": "761b80282f76e6da6862b84261f736cac83d340bac555b4c9a6eba20c66cf149"
      }
    },
    "none_na": {
      "label": {
        "text": "אין / לא רלוונטי",
        "source_sha256": "99268e9638155968a89d5ecbb4ae998ddec309bae9c3f5b0a4e457feb83fced5"
      },
      "boilerplate": {
        "text": "הקצאת IGA / Enterprise אינה חלה על גבול ההערכה עבור מופע קלסר זה, או שאין יכולת IGA בהיקף. המפעילים חייבים לאשר זאת עם ה-OSP לפני הייצוא. זו לא טענה שבקרות ההקצאה הן MET.",
        "source_sha256": "f295f42c80f3b3edc75c5b02f2f38311c138bbdda4fd5181f6480938632fae67"
      }
    }
  },
  "profiles": {
    "cmmc": {
      "label": {
        "text": "CMMC",
        "source_sha256": "0ecd57c0c4a4e075944d57d01aedc7c6e7cd733d982f0aad4bf53678ab1a0fe9"
      },
      "explanation": {
        "text": "CMMC (32 CFR 170) היא אריזת הערכת DoD מעל NIST SP 800-171 (וברמה 3, דרישות משופרות של NIST SP 800-172). רמה 1 מכסה הגנה בסיסית של FCI; רמה 2 מתאימה לשיטות 110 800-171 Rev 2 עבור CUI; רמה 3 מוסיפה דרישות משופרות של 800-172. CMMC אינה מחליפה את רצפת התכנון של הבקרה NIST SP 800-53 Rev 5 - היא מכילה עדויות הערכה עבור סקירת C3PAO / DoD.",
        "source_sha256": "cceb486611a80d28672aafc4ca0f2e48a4052220b013af9c3078e586916ab1d3"
      }
    },
    "nist_800_171": {
      "label": {
        "text": "NIST SP 800-171",
        "source_sha256": "f4856a2f7a01e12a623398b039c99476d5205d6791886eca5cb0357ebaeb3953"
      },
      "explanation": {
        "text": "NIST SP 800-171 Rev 2 מגדיר 110 דרישות אבטחה ב-14 משפחות להגנה על CUI במערכות לא פדרליות. אריזה ברמה 1 מתמקדת בפרקטיקות בסיסיות / מוכוונות FCI; רמה 2 היא ערכת התרגול המלאה של 110 המוצמדת בדרך כלל לרמה 2 של CMMC; מסגור ברמה 3 עשוי להתייחס לציפיות משופרות נוספות. עיצוב בקרת המוצר עדיין עוקב אחר הרצפה NIST SP 800-53 Rev 5; 800-171 היא אריזת הערכה מעל אותה קומה.",
        "source_sha256": "8c49b236b9e9a09787b9b81bb1a4752d606cea1724793135b9b6b8ad31f5f42f"
      }
    },
    "nist_800_172": {
      "label": {
        "text": "NIST SP 800-172",
        "source_sha256": "d8c82bfcd76ff4b5cf43ca875aa422768965b436af851f30c37854a6a70f6eb0"
      },
      "explanation": {
        "text": "NIST SP 800-172 (פברואר 2021) מוסיף 35 דרישות אבטחה משופרות מעבר ל-800-171. CMMC Level 3 בוחרת תת-קבוצה של אלה. תצוגת אריזה זו מדגישה דרישות משופרות יחד עם הראיות הבסיסיות 800-171 / CMMC. תביעות משופרות לא מוכחות נשארות פער או לא ידועות - החלפת כאן מסננים/מיפוי מחדש של היקף; זה לא ממציא ראיות מארח חדשות.",
        "source_sha256": "6a040a57641ec670d2c9dc3c1f3a771fc2c1ecf7adb60bde6070e360b401f98e"
      }
    },
    "nist_800_53": {
      "label": {
        "text": "NIST SP 800-53",
        "source_sha256": "2c8cae03f30fab0b8a30bbea566d264a76f93797a963653e6711af0d98348719"
      },
      "explanation": {
        "text": "NIST SP 800-53 Rev 5 היא רצפת עיצוב הבקרה עבור מוצר זה (קו בסיס בינוני, עם High כאשר נבחר). משפחות בקרה (AC, AU, CM, IA, SC, SI ואחרות) מארגנות את הקטלוג. שורות CMMC / 800-171 / 800-172 במקומות אחרים הם שכבות על אריזות הערכה שעושות שימוש חוזר באותן ראיות מובלעת - הן אינן תחליף דק יותר לרצפה 800-53.",
        "source_sha256": "3db2e0c83b144ffe6fd7d4c3b5693439fefe46ef0c3fb867f2a5973362767e6c"
      }
    },
