  "explanations": {
    "cmmc": {
      "text": "CMMC (32 CFR 170) é um pacote de avaliação do DoD acima de NIST SP 800-171 (e do Nível 3 selecionado requisitos NIST SP 800-172). Nível 1: proteção FCI básica; Nível 2: 110 800-171 Práticas para CUI; Nível 3: requisitos avançados de 800-172. CMMC não substitui NIST SP 800-53 Rev. 5 como piso de design.",
      "source_sha256": "3cea730a3ae235201a8504ac9ae141ff29b230ec2a3a419403ef10435c0eb359"
    },
    "nist_800_171": {
      "text": "NIST SP 800-171 Rev. 2 define 110 requisitos de segurança em 14 famílias para proteger CUI em sistemas não federais. O nível 2 corresponde ao conjunto de 110 práticas (geralmente com CMMC Nível 2). O design do produto continua seguindo NIST SP 800-53 Rev. 800-171 está classificando as embalagens sobre isso.",
      "source_sha256": "7444d4520ad2ca1b06c2a66b03de41c54453fda41b6caafded746961a926df92"
    },
    "nist_800_172": {
      "text": "NIST SP 800-172 (fevereiro de 2021) adiciona 35 requisitos expandidos além de 800-171. CMMC O estágio 3 seleciona um subconjunto. As reivindicações melhoradas não comprovadas permanecem lacunas ou desconhecidas.",
      "source_sha256": "65cf5967ecbb7d0b43d05a9c9a41be2f749dcf6c080cd5e6957f01e5dff8a584"
    },
    "nist_800_53": {
      "text": "NIST SP 800-53 Rev. 5 é o piso de projeto dos controles deste produto (linha de base moderada, alta se aplicável). CMMC / 800-171 / 800-172 são sobreposições que usam a mesma evidência do enclave.",
      "source_sha256": "78e5f81c2759de85921f435bb9e498c40affd56902849f322ff4b11839669ef2"
    }
  },
