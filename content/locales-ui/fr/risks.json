  "severityColHelp": {
    "text": "D’après la vraisemblance et l’impact enregistrés sous la matrice d’évaluation en vigueur. Une ligne dont la lecture a changé depuis la capture l’indique sous la pastille.",
    "source_sha256": "5f16f82fd18cc61ac1cb18e858df983729254a6fce712589e791986feef3a4bc"
  },
  "statusColHelp": {
    "text": "Ce qui a été décidé récemment concernant ce risque. Les valeurs de statut sont des décisions enregistrées et non un résultat d'évaluation.",
    "source_sha256": "d9fbc7430001dc38492f31c3b9413f2a2da795d7d817408341f42cc29877e965"
  },
  "reviewColHelp": {
    "text": "Quand faut-il ensuite examiner ce risque ? Le retard est calculé à la lecture de cette liste ; rien ne l'annonce.",
    "source_sha256": "f01b9b6b031250ffd5a2282486dc6867f332736b872581be4b9d0f822ddc3d59"
  },
  "acceptanceColHelp": {
