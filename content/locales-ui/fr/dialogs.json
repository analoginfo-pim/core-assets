  "adminAuthHelp": {
    "titleUnauthorized": {
      "text": "Demande de l'administrateur refusée (401)",
      "source_sha256": "b8722d8b3d37dc48d99beb168b71efed46b018bf3f4d3d3b569c728fd9b178b3"
    },
    "titleManual": {
      "text": "Accès à l'API d'administration",
      "source_sha256": "94be4815a1a196e33b7e69b001dd6ba94265a8332e8b073584b9c1695762b165"
    },
    "unauthorizedBody": {
      "text": "Une route protégée sur /api/admin/ a renvoyé 401 non autorisé. Si l'authentification de session IAM est active, votre connexion est généralement expirée : reconnectez-vous. Sans authentification de session, le secret de connexion administratif du navigateur ne correspond pas au ADMIN_TOKEN stocké sur le serveur (par exemple après une réinitialisation de la base de données ou lorsqu'un seul côté de la paire a été modifié). Après avoir corrigé le jeton, rechargez matériellement ou ouvrez /login pour établir une nouvelle session IAM.",
      "source_sha256": "041b6f1655b35a81efdfa78f4b5903983dbc1529d06562b716ad82826463df96"
    },
    "quickFacts": {
      "text": "Faits rapides :",
      "source_sha256": "34b49dd74fe116122d2b22134721810ae25decdd9103709cf833b6fe3a7e8204"
    },
    "oneNamePrimary": {
      "text": "Un nom : ADMIN_TOKEN",
      "source_sha256": "5eb3b2ed3c69991253061d3be88ff3e7ef00351e89fa60507dd8cdd63a93b146"
    },
    "oneNameSecondary": {
      "text": "Le secret du manifeste du serveur s'appelle ADMIN_TOKEN. Ce navigateur l'ajoute à chaque demande d'administrateur en tant qu'en-tête HTTP {{header}} (et jeton X-Admin pour les anciennes versions). Valeur {{token}} jusqu'à ce que le véritable RBAC remplace ce stub. Il n'existe pas de valeur de registre distincte appelée {{header}} — il s'agit simplement du nom de l'en-tête du fil.",
      "source_sha256": "4f48f0046f99ef619410e3f0fdf81033c69619ac329d68e9f800e21427dc7db0"
    },
    "whereSecretsPrimary": {
      "text": "Wo the Server Geheimnisse speichert (Windows)",
      "source_sha256": "ba2eefc31e3b7c2dd8e9ff8799704ebf5339d403d147ede46a2c289d617658aa"
    },
    "whereSecretsSecondary": {
      "text": "Les paramètres à l’échelle de la machine se trouvent sous {{settings}} (de préférence) ou {{settingsLegacy}} sur les anciennes installations. Les secrets tels que ADMIN_TOKEN résident sous {{secrets}} (de préférence) ou {{secretsLegacy}} en tant que valeurs de registre cryptées. Les services exécutés en tant que LocalSystem lisent directement ces clés. Windows Credential Manager n'est pas utilisé pour les secrets d'exécution du serveur ou de l'agent : il est par utilisateur et n'est pas disponible pour les comptes de service.",
      "source_sha256": "a58e912f42d67e598017536e2aa27004ca4fe4dfa91e7190bd8055ff4f39b334"
    },
    "unixPrimary": {
      "text": "Unix / macOS",
      "source_sha256": "eb22bccdb665389d79d6499dbc2f811c9995bc910b503f319caa453492fe5a84"
    },
    "unixSecondary": {
      "text": "Paramètres sous /etc/aic/ ou /Library/Application Support/com.analoginfo/ ; Secrets via le trousseau de clés de la plateforme (Linux Secret Service / macOS Trousseau), et non sous forme de fichiers texte brut.",
      "source_sha256": "ec2c7f1bade38336ca55f5f133b65480bc0b47ad8a420895abe8275e07b45268"
    },
    "iamPrimary": {
      "text": "Authentification de session IAM",
      "source_sha256": "3fac2c410424e741a8cb10e1af6d9bd075c0d90092ec1f310b70242098160d03"
