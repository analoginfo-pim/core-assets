  "explanations": {
    "cmmc": {
      "text": "CMMC (32 CFR 170), NIST SP 800-171 (ve Seviye 3'ten seçilen NIST SP 800-172 gereksinimleri) üzerinden Savunma Bakanlığı değerlendirme paketidir. Seviye 1: temel FCI koruması; Seviye 2: 110 800-171 CUI Uygulamaları; Seviye 3: ileri düzey 800-172 gereksinimleri. CMMC, tasarım zemini olarak NIST SP 800-53 Rev. 5'in yerini almaz.",
      "source_sha256": "3cea730a3ae235201a8504ac9ae141ff29b230ec2a3a419403ef10435c0eb359"
    },
    "nist_800_171": {
      "text": "NIST SP 800-171 Rev. 2, federal olmayan sistemlerde CUI'yi korumak için 14 ailede 110 güvenlik gereksinimini tanımlar. Seviye 2, 110 pratik setine karşılık gelir (genellikle CMMC Seviye 2 ile). Ürün tasarımı NIST SP 800-53 Rev. 5'i takip etmeye devam ediyor; 800-171 bu konuda paketlemeyi derecelendiriyor.",
      "source_sha256": "7444d4520ad2ca1b06c2a66b03de41c54453fda41b6caafded746961a926df92"
    },
    "nist_800_172": {
      "text": "NIST SP 800-172 (Şubat 2021), 800-171'in ötesinde 35 genişletilmiş gereksinim ekler. CMMC Aşama 3 bir alt küme seçer. Kanıtlanmamış gelişmiş iddialar boşluklarda kalıyor veya bilinmiyor.",
      "source_sha256": "65cf5967ecbb7d0b43d05a9c9a41be2f749dcf6c080cd5e6957f01e5dff8a584"
    },
    "nist_800_53": {
      "text": "NIST SP 800-53 Rev. 5 bu ürünün denetim tasarım tabanıdır (Orta temel, uygulanabilirse Yüksek). CMMC / 800-171 / 800-172 aynı sığınak kanıtını kullanan katmanlardır.",
      "source_sha256": "78e5f81c2759de85921f435bb9e498c40affd56902849f322ff4b11839669ef2"
    }
  },
