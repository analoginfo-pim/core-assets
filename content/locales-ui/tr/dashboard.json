  "honestyNotes": {
    "env": {
      "systems_count": {
        "text": "Şu andaki kayıtlı enklav sistem sayısı. Eğilim çizgileri örneklenmiş geçmiş kullanır; ilk örnekten önce dizi boştur ve geçmiş o örnekte başlar. Bir kapsam yüzdesi ve bir değerlendirme sonucu değildir.",
        "source_sha256": "69db030a51534b9f1c94b4fc22caa29a357b0ec4f5103a77832e90ae82f4f420"
      },
      "probe_enabled_count": {
        "text": "Şu anda kaç kayıtlı sistemde probing açık. Eğilim çizgileri örneklenmiş geçmiş kullanır; ilk örneğe kadar boştur. Etkin probing, bir denetimin geçtiğinin kanıtı değildir.",
        "source_sha256": "6b4019cc538d7e6452bba4d7e522f9a461163c02db6bc0e7aef58edcb84d3619"
      },
      "physical_vs_log": {
        "text": "physical_host ile log_derived etiketli en son kanıt satırlarının dağılımı. Eğilim çizgileri örneklenmiş geçmiş kullanır; ilk örneğe kadar boştur. Yalnızca toplanan kanıtın bileşimi — bir geçme oranı değildir.",
        "source_sha256": "2855f98debf6941663aedc64b7d515611ce8065d6126f3bbbefb7e54e93d7710"
      },
      "punch_list_open": {
        "text": "En son filo kanıtından açık bulgular ve kısmi sonuçlar. Operatörler için teslimat birikimi — artık risk puanı değildir. Eğilim çizgileri örneklenmiş geçmiş kullanır; ilk örneğe kadar boştur.",
        "source_sha256": "892e38b032e917ebc3e1f700df18c4531b2fbb56c67a8f4992a3738468d7531f"
      },
      "discovered_systems": {
        "text": "Kimliği discovery (içe aktarma / tarama / dizin) kaynaklı kayıtlı sistemler. Eğilim çizgileri o kayıt kaynağı sayısının örneklenmiş geçmişini kullanır; ilk örneğe kadar boştur — ön geçmiş noktaları uydurmayın.",
        "source_sha256": "de19ba275f78d499fb3efa2f0526d1449bffa600d502c0b7de15f1102c865e6c"
      }
    },
    "training": {
      "framework_coverage": {
        "text": "Covered, o standardın bir maddesini atıf yapan bir eğitim belgesinin bulunduğu anlamına gelir. Belgenin okunduğu anlamına gelmez ve bir denetim değerlendirmesi değildir. Eğilim çizgileri örneklenmiş geçmiş kullanır; ilk örneğe kadar boştur.",
        "source_sha256": "a8be8f3e73b4b91f364a40d87d643ac04e08d3ab20383238fef47a64d8ad5a15"
      },
      "uncovered_frameworks": {
        "text": "İş gücü farkındalığını zorunlu kılan ancak kitaplıkta henüz kapsayan belgesi olmayan çerçeveler. Belge boşluğu — personelin eğitimsiz olduğu bulgusu değildir. Eğilim çizgileri örneklenmiş geçmiş kullanır; ilk örneğe kadar boştur.",
        "source_sha256": "784464ec9f7d460d2ca6834bb60f8c8ae28c5bbd2684625a205de9d1d7481aa2"
      }
    },
    "compliance": {
      "pack_readiness": {
        "text": "available, partial, planned veya blocked teslimat durumlarındaki Report Center ailelerinin sayıları. Ürün toplayıcılarının hazırlığı — asla bir CMMC veya FedRAMP kararı değildir. Eğilim çizgileri örneklenmiş geçmiş kullanır; ilk örneğe kadar boştur.",
        "source_sha256": "9beb070ca0de42316f2835009cf5f98bb8253d564e55ed2cd3c21c5ae8400f8c"
      },
      "poam_open": {
        "text": "open, in_progress veya deferred durumundaki POA&M satır sayısı. Kaydedilen iyileştirme çalışmalarını izler — maruziyetin kabul edilebilir olup olmadığını göstermez. Eğilim çizgileri örneklenmiş geçmiş kullanır; ilk örneğe kadar boştur.",
        "source_sha256": "5a896b5deb083d047b45798d2968c20f5eb14923a05d1ca423b64f19e8aacf4b"
      },
      "attestations_recorded": {
        "text": "attested_at değeri seçilen 7/30/90 günlük pencerede (varsayılan 30) olan offline_compliance_attestations satır sayısı. Attestasyon kayıtlarının yazıldığının kanıtı — gerekli her attestasyonun tamamlandığı anlamına gelmez.",
        "source_sha256": "a54857fb8f45e50b3e5423ad1825b8e6d061f9ba89707a729577c5494235ac68"
      }
    },
    "pum": {
      "violations_24h": {
        "text": "Her örnekte son 24 saatte kaydedilen privileged-use management ihlal olayları. Eğilim çizgileri seçilen 7/30/90 penceresinde o örneklenmiş geçmişi kullanır; ilk örneğe kadar boştur. Bir önem puanı değildir.",
        "source_sha256": "fa97fb2f5cb07cc43edb78acfb4d18d6c15c5742f59f234b75f96d508ac3d0dd"
      },
      "endpoints_enrolled": {
        "text": "Şu anda PUM ilkesi ataması olan uç noktalar. Eğilim çizgileri örneklenmiş geçmiş kullanır; ilk örneğe kadar boştur. Yalnızca kayıt sayısı — uygulama kalitesi değildir.",
        "source_sha256": "f9782cd71f65e67c68227b52dc200d793849ce54eec82bf92c9fb6ba0a12e5af"
      }
    },
    "ir": {
      "open_cases": {
        "text": "opened_at değeri seçilen 7/30/90 günlük pencerede (varsayılan 30) olan open veya processing durumundaki IR vaka sayısı. offline_ir_cases kaynaklı iş yükü birikimi — olay müdahalesinin etkili olduğu yargısı değildir. Metrik örnekleyicisi gelene kadar çizgi grafiklerin günlük geçmişi yoktur; boş dizi açıktır, uydurulmuş sıfır eğilim değildir.",
        "source_sha256": "a91e296ab260af632c2660d7067801347d7cb3d18e92e1c86b64fbbb0322ca49"
      },
      "cases_opened_closed": {
        "text": "offline_ir_cases kaynağından, opened_at veya closed_at değeri seçilen 7/30/90 günlük pencerede (varsayılan 30) olan vakalar. Kaydedilen vaka çalışmasının çıktısı — yanıt kalitesi veya denetim etkinliği değildir.",
        "source_sha256": "7ade5f268580015310b250936cd9867ca900607fa7ef4c9eadd204b93f29b9fc"
      }
    },
    "defense": {
      "blocked_attempts": {
        "text": "Seçilen 7/30/90 günlük pencerede başarısız ve reddedilen oturum açmalar ile engellenen API istekleri. Yalnızca reddedilen deneme sayıları — saldırganların komut çalıştırdığı veya kötü amaçlı yazılımın yakalandığı iddiası değildir. Engellenen Saldırılar sayfasını açar.",
        "source_sha256": "142c4df58a904c676ac11691195f2c9b92b506f8e5540446b4fdd8c680f23543"
      }
    },
    "events": {
      "by_type": {
        "text": "Şu anda işlem içi olay halka arabelleğinden sayılar. Kalıcı geçmiş değildir ve 7/30/90 eğilimi değildir — arabellek boyutu gördüklerinizi sınırlar.",
        "source_sha256": "260d7582bad3557747bfacc83be9d06e2fef0f3134c76d6fefe9a4a79c6bb527"
      }
    }
  },
