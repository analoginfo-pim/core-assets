    "intro": {
      "text": "Download Agents and settings files for this server. Installing an Agent does not certify the organization.",
      "source_sha256": "06eac51196802787cc39a17b1d78f1209f60696c4c39048693f26fd059e29789"
    },
    "inventoryPurpose": {
      "text": "These Agents inventory seats and validate the required state for the CMMC standard in effect. The standard in effect is the configured operating package ({{package}}). Inventory and required-state validation are product contribution. They are not Met, they do not certify a seat, and they do not replace the assessor.",
      "source_sha256": "e46e25ee07d3c64e1de324a6a21c4d8b23781278bca06e3fb0ea6bc7ea6834ab"
    },
    "inventoryPurposeUnset": {
      "text": "These Agents inventory seats and validate the required state for the CMMC standard in effect. The operating package is not set. Choose L1 Fast, L2 Isolated, L3 Overlay, or NIST SP 800-53 in Settings. Until then, Agents still inventory seats; required-state validation follows the package you configure. Inventory and required-state validation are product contribution. They are not Met, they do not certify a seat, and they do not replace the assessor.",
      "source_sha256": "85b08599fe45f8bee749857079830c53ec2ff16566d9330df72c04122bba63af"
    },
