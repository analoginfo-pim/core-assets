    },
    "settingsBody": {
      "text": "The settings file is not a generic configuration list. It carries unique cryptographic material that starts the initial secure connection. After the Agent enrolls and checks in, the server updates that material and pushes the remaining settings. The user interface never shows private keys, PINs, or tokens.",
      "source_sha256": "69975636ae30e0279cf912c9cf5c3f7ace1310c21c01c689acaf947213dbab4e"
    },
    "settingsTitle": {
