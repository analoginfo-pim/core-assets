    },
    "title": {
      "text": "Agents Download",
      "source_sha256": "3005ea18d31ce72c8c4d8dda850f357416f9127710289ceb62ed6bbb9a85daea"
    },
    "whereBody": {
      "text": "After check-in, seats appear on Systems, Fleet Agent Versions, and Workstation Assurance. Elevation and recording surfaces use the Agent that is already on the seat. Those pages show delivery state, not Met.",
      "source_sha256": "52a92e8ab6759a00c26e0e0176c4aeea3f4eab12220fae3efd630cd12f344134"
    },
    "whereTitle": {
      "text": "Where Agents appear",
      "source_sha256": "684a0c5bedf219062fd9b7ec97295855d4a4cf9dc70a71cbe1c1cb9fd2d0beda"
    },
    "whyBody": {
      "text": "Agents provide endpoint presence, check-in, inventory, and required-state evidence for the operating package in effect. That is toolkit contribution. It does not mean the organization passed an assessment.",
      "source_sha256": "7b8a9efa155870c4a0136513245b066ca23c51082347120813b9e0a78a68a8b7"
    },
    "whyTitle": {
