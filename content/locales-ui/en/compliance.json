  "explanations": {
    "cmmc": {
      "text": "CMMC (32 CFR 170) is DoD assessment packaging over NIST SP 800-171 (and from Level 3 selected NIST SP 800-172 requirements). Level 1: basic FCI protection; Level 2: 110 800-171 Practices for CUI; Level 3: advanced 800-172 requirements. CMMC does not replace NIST SP 800-53 Rev. 5 as a design floor.",
      "source_sha256": "3cea730a3ae235201a8504ac9ae141ff29b230ec2a3a419403ef10435c0eb359"
    },
    "nist_800_171": {
      "text": "NIST SP 800-171 Rev. 2 defines 110 security requirements in 14 families to protect CUI in non-federal systems. Level 2 corresponds to the 110 practice set (often with CMMC Level 2). The product design continues to follow NIST SP 800-53 Rev. 5; 800-171 is rating packaging about it.",
      "source_sha256": "7444d4520ad2ca1b06c2a66b03de41c54453fda41b6caafded746961a926df92"
    },
    "nist_800_172": {
      "text": "NIST SP 800-172 (Feb. 2021) adds 35 expanded requirements beyond 800-171. CMMC Stage 3 selects a subset. Unproven enhanced claims remain gaps or unknown.",
      "source_sha256": "65cf5967ecbb7d0b43d05a9c9a41be2f749dcf6c080cd5e6957f01e5dff8a584"
    },
    "nist_800_53": {
      "text": "NIST SP 800-53 Rev. 5 is the control design floor of this product (Moderate Baseline, High if applicable). CMMC / 800-171 / 800-172 are overlays that use the same enclave evidence.",
      "source_sha256": "78e5f81c2759de85921f435bb9e498c40affd56902849f322ff4b11839669ef2"
    }
  },
