  "adminAuthHelp": {
    "titleUnauthorized": {
      "text": "Gestione della domanda dell'amministratore (401)",
      "source_sha256": "aff72ace4c9c96e04f0608e70a43200d19caf51749482d0eb35ee05fd33fc48b"
