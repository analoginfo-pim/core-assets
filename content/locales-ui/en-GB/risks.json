  },
  "expiryNotice": {
    "text": "An expired acceptance is calculated upon reading. A 12-hour run sends RiskAcceptanceLapsed once for each acceptance whose granted period ended. The event reports the expiration date. It doesn't reopen risk, pull back acceptance, or escalate anything. Delivery depends on the event destinations an operator has set up.",
    "source_sha256": "6d7cf5ce3cbd16c8d61d9a948fd87d5b15ffdb948a4ddd95d3554ca88beed178"
  },
