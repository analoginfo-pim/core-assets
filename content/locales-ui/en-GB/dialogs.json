  "adminAuthHelp": {
    "titleUnauthorized": {
      "text": "Administratoranfrage abgelehnt (401)",
      "source_sha256": "aff72ace4c9c96e04f0608e70a43200d19caf51749482d0eb35ee05fd33fc48b"
    },
    "titleManual": {
      "text": "Admin API access",
      "source_sha256": "94be4815a1a196e33b7e69b001dd6ba94265a8332e8b073584b9c1695762b165"
    },
    "unauthorizedBody": {
      "text": "A protected route at /api/admin/ returned 401 Unauthorised. If IAM session authentication is active, your login is usually expired — log in again. Without session authentication, the browser's administrative login secret does not match the ADMIN_TOKEN stored on the server (e.g. after a database reset or when only one side of the pair was changed). After correcting the token, hard reload or open /login to establish a new IAM session.",
      "source_sha256": "041b6f1655b35a81efdfa78f4b5903983dbc1529d06562b716ad82826463df96"
    },
    "quickFacts": {
      "text": "Kurzinfos:",
      "source_sha256": "b4f3ee1eec63195b67a0f0c04ad39d32b3d6914dabab6c2dd0e996d9883dd1bc"
    },
    "oneNamePrimary": {
      "text": "Ein Name: ADMIN_TOKEN",
      "source_sha256": "6a42766ea0badc1cf03bb537cfbfb7e0b24e47bf0ff161e97d93ce1f93902022"
    },
    "oneNameSecondary": {
      "text": "The server manifest secret is called ADMIN_TOKEN. This browser appends it to every admin request as HTTP header {{header}} (and X-Admin token for older builds). Value {{token}} until real RBAC replaces this stub. There is no separate registry value called {{header}} — that is just the wire header name.",
      "source_sha256": "4f48f0046f99ef619410e3f0fdf81033c69619ac329d68e9f800e21427dc7db0"
    },
    "whereSecretsPrimary": {
      "text": "Wo the Server Geheimnisse speichert (Windows)",
      "source_sha256": "ba2eefc31e3b7c2dd8e9ff8799704ebf5339d403d147ede46a2c289d617658aa"
    },
    "whereSecretsSecondary": {
      "text": "Maschinenweite Settings liegen unter {{settings}} (bevorzugt) or {{settingsLegacy}} bei aelteren Installationen. Geheimnisse wie ADMIN_TOKEN liegen unter {{secrets}} (bevorzugt) or {{secretsLegacy}} als verschluesselte Registrierungswerte. Dienste als LocalSystem lesen diese Schluessel direkt. Windows Credential Manager wird not for Server- or Agent-Laufzeitgeheimnisse genutzt — es ist benutzerbezogen and for Dienstkonten not verfuegbar.",
      "source_sha256": "0180a3a98eadcb44616957fbea4693cedd8796aa422cccb994d4a7c97d5a162b"
    },
    "unixPrimary": {
      "text": "Unix / macOS",
      "source_sha256": "eb22bccdb665389d79d6499dbc2f811c9995bc910b503f319caa453492fe5a84"
    },
    "unixSecondary": {
      "text": "Settings under /etc/aic/ or /Library/Application Support/com.analoginfo/; Secrets via the platform keyring (Linux Secret Service / macOS Keychain), not as plain text files.",
      "source_sha256": "ec2c7f1bade38336ca55f5f133b65480bc0b47ad8a420895abe8275e07b45268"
    },
    "iamPrimary": {
      "text": "IAM-Sitzungsauthentifizierung",
      "source_sha256": "bdc9c9abf4cb87bcb0fb6ac8c3e8f8f8e7bfbe4877f23c09b0018fed1ec59cbb"
    },
    "iamSecondary": {
      "text": "Wenn IAM_SESSION_AUTH_ENABLED wahr ist, ist a gueltige Sign-in (or the gemeinsamen ADMIN_TOKEN-Header without gespeicherte Session) erforderlich. Abgelaufene Sitzungstoken werden geloescht and the Browser to /login geschickt.",
      "source_sha256": "ed79e51dfec47ae9476ee58786336c2b198ee4c3d1ffc6b825ec5e7ef1eadb2c"
    },
    "operatorsFooter": {
