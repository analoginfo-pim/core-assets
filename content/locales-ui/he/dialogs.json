  "adminAuthHelp": {
    "titleUnauthorized": {
      "text": "בקשת מנהל המערכת נדחתה (401)",
      "source_sha256": "b8722d8b3d37dc48d99beb168b71efed46b018bf3f4d3d3b569c728fd9b178b3"
    },
    "titleManual": {
      "text": "גישה ל-API של מנהל מערכת",
      "source_sha256": "94be4815a1a196e33b7e69b001dd6ba94265a8332e8b073584b9c1695762b165"
    },
    "unauthorizedBody": {
      "text": "נתיב מוגן ב-/api/admin/ החזיר 401 לא מורשה. אם אימות הפעלת IAM פעיל, פג תוקף ההתחברות שלך - היכנס שוב. ללא אימות הפעלה, סוד הכניסה האדמיניסטרטיבי של הדפדפן אינו תואם ל-ADMIN_TOKEN המאוחסן בשרת (למשל לאחר איפוס מסד נתונים או כאשר רק צד אחד של הזוג שונה). לאחר תיקון האסימון, טען מחדש חזק או פתח את /התחברות כדי ליצור הפעלה חדשה של IAM.",
      "source_sha256": "041b6f1655b35a81efdfa78f4b5903983dbc1529d06562b716ad82826463df96"
    },
    "quickFacts": {
      "text": "קורזין:",
      "source_sha256": "b4f3ee1eec63195b67a0f0c04ad39d32b3d6914dabab6c2dd0e996d9883dd1bc"
    },
    "oneNamePrimary": {
      "text": "שם עין: ADMIN_TOKEN",
      "source_sha256": "6a42766ea0badc1cf03bb537cfbfb7e0b24e47bf0ff161e97d93ce1f93902022"
    },
    "oneNameSecondary": {
      "text": "סוד המניפסט של השרת נקרא ADMIN_TOKEN. דפדפן זה מוסיף אותו לכל בקשת מנהל בתור כותרת HTTP {{header}} (ואסימון X-Admin עבור רכיבי בנייה ישנים יותר). ערך {{token}} עד ש-RBAC אמיתי יחליף את הבדל הזה. אין ערך רישום נפרד בשם {{header}} - זה רק שם כותרת החוט.",
      "source_sha256": "4f48f0046f99ef619410e3f0fdf81033c69619ac329d68e9f800e21427dc7db0"
    },
    "whereSecretsPrimary": {
      "text": "Wo the Server Geheimnisse speichert (Windows)",
      "source_sha256": "ba2eefc31e3b7c2dd8e9ff8799704ebf5339d403d147ede46a2c289d617658aa"
    },
    "whereSecretsSecondary": {
      "text": "הגדרות לכל המכונה פועלות מתחת ל-{{settings}} (מועדף) או {{settingsLegacy}} בהתקנות ישנות יותר. סודות כגון ADMIN_TOKEN חיים תחת {{secrets}} (מועדף) או {{secretsLegacy}} בתור ערכי רישום מוצפנים. שירותים הפועלים כ-LocalSystem קוראים מפתחות אלה ישירות. Windows Credential Manager אינו משמש עבור סודות זמן ריצה של שרת או סוכן — הוא לכל משתמש ואינו זמין לחשבונות שירות.",
      "source_sha256": "a58e912f42d67e598017536e2aa27004ca4fe4dfa91e7190bd8055ff4f39b334"
    },
    "unixPrimary": {
      "text": "יוניקס / macOS",
      "source_sha256": "eb22bccdb665389d79d6499dbc2f811c9995bc910b503f319caa453492fe5a84"
    },
    "unixSecondary": {
      "text": "הגדרות מתחת ל- /etc/aic/ או /Library/Application Support/com.analoginfo/; ה-Plattform-Keyring (Linux Secret Service / MacOS Keychain), לא כמו Klartextdateien.",
      "source_sha256": "85f4f0ce310d449dc6381e75d16df35ff7e8a511b3d0d3f8f571f4f300318985"
    },
    "iamPrimary": {
      "text": "אימות הפעלה של IAM",
      "source_sha256": "3fac2c410424e741a8cb10e1af6d9bd075c0d90092ec1f310b70242098160d03"
    },
    "iamSecondary": {
      "text": "כאשר IAM_SESSION_AUTH_ENABLED יש לך כניסה, היא מתאימה (או ה-gemene ADMIN_TOKEN-Header ללא הפעלה ספיציפית) erforderlich. Abgelaufene Sitzungstoken werden geloescht והדפדפן ל /login geschickt.",
      "source_sha256": "ed79e51dfec47ae9476ee58786336c2b198ee4c3d1ffc6b825ec5e7ef1eadb2c"
    },
    "operatorsFooter": {
