    "au": {
      "title": {
        "text": "רשומות שמירה",
        "source_sha256": "69923a7b65458f468ce05686994c2cabd470b26abd9f57650986a382b438ae34"
      },
      "summary": {
        "text": "רשום אישור שמירה או מסירת ייצוא עם גיבוב. הפעלת אחסון WORM נשארת בידי הארגון. זה אינו Met.",
        "source_sha256": "4a0bb733142703f9abea97e16740baaf9beae99cc64649ae62054c2d06212e37"
      },
      "add": {
        "text": "רשום שמירה",
