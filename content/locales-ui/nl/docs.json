          },
          "2": {
            "text": "Voorinstelling voor inschrijving",
            "source_sha256": "a17f139a800b40ba79072e64cadb7a194d4e9c53938806d6fadf9a67b4b995e8"
          },
          "3": {
            "text": "Kan doen",
            "source_sha256": "2de2c8f7e0f142fc595dfc3b82b8ce30841e6a9ca3a7560742c1e10823786b41"
          },
          "4": {
            "text": "Mag niet",
            "source_sha256": "718e628f3829d259821ebdd30c7c5f43d0d99378ee8a120e16df2b366a601b70"
          }
        },
        "rows": {
          "0": {
            "0": {
              "text": "Alleen-lezen waarnemer",
              "source_sha256": "124a075178664d2ee91ff8fc4b9105d0836a437049fc24111597b6155b208eda"
            },
            "1": {
              "text": "Alleen-lezen beoordelaars en documentatiegebruikers",
              "source_sha256": "b9850db67366f8e12d47aca92555920fcb1fb9c5627a1f58254c67feecf2ca1d"
            },
            "2": {
              "text": "alleen-lezen-beoordelaar",
              "source_sha256": "78218efaecc299d8937a7ccb02b5218dcbb87b5817793e358b7e009245532e47"
            },
            "3": {
              "text": "Bekijk Assessment Binder en rapporten",
              "source_sha256": "9d46e9a523253882459bbfe2fcdb69c3dc2e943f89f6a3334fad58bd3ad446ec"
            },
            "4": {
              "text": "Schrijf binderinhoud, Fix-It of beheer identiteiten",
              "source_sha256": "82fd8376cc83606a3a7e1fd9e5c91a5b8331dbdd60447019613ac890b785f017"
            }
          },
          "1": {
            "0": {
              "text": "Werkende auditor (auditor)",
              "source_sha256": "944d1f7fee040102f42afef4a10b48a4992a6f40fefbaa0e98a0ec7c941cc6ab"
            },
            "1": {
              "text": "CMMC-beoordelaars, beoordelingsteam en documentatiegebruikers",
              "source_sha256": "b48d7428c73de6aa422f5de2de8d6eef73c438fec280ac7916831ee0a9494838"
            },
            "2": {
              "text": "cmmc-beoordelaar",
              "source_sha256": "6613533426ca2300e9c63eeb209573f98c115704d96509ebe7fd95e42560526d"
            },
            "3": {
              "text": "Schrijf binderinhoud, beoordeel opdrachten, onderhoud risico's",
              "source_sha256": "e6d4700c06f8b2c0571430eeef7a57778c7c1a0f7093b3c898f6f4cd37c28549"
            },
            "4": {
              "text": "Maak accounts aan, reset wachtwoorden, Fix-It of accepteer restrisico",
              "source_sha256": "7ed48f8d001148d1a523e82d8e19089fa9bd91d315a39d408e194ffd0fb238e4"
            }
          },
          "2": {
            "0": {
              "text": "Hoofdauditor (auditbeheerder)",
              "source_sha256": "ad327d82e6d729f67843d72b3dc5d3820b11479f40abd170d786e44a537595f1"
            },
            "1": {
              "text": "Hoofdauditors, CMMC-beoordelaars, beoordelingsteam en documentatiegebruikers",
              "source_sha256": "5f38ef6b0333ece489762dd38e800f99608fddcfa85dfd6d07cdca9721b00d28"
            },
            "2": {
              "text": "hoofdauditor",
              "source_sha256": "4012403d359f568308ee40454e0f6062e277496074f12d38353777ac7e185f51"
            },
            "3": {
              "text": "Hetzelfde als een werkende auditor, plus accounts van auditorklassen maken, deze toevoegen aan auditorgroepen, alleen die wachtwoorden opnieuw instellen en opdrachten beheren",
              "source_sha256": "a7c2351fa40bcbee672810e7cb7fa60ada50db21e8dabc927841136e12c822f6"
            },
            "4": {
              "text": "Reset beheerderswachtwoorden, wijs Super Admin toe, beheer identiteitsproviders of Fix-It",
              "source_sha256": "8e7a60df7c9f329660a9a05c3c3d20c7f9f5daf7e7689e3ea4dfa2d631296a3c"
            }
          }
        }
      },
      "seeds": {
