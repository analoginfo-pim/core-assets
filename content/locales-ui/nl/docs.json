    "configLinks": {
      "0": {
        "label": {
          "text": "Melden",
          "source_sha256": "a329a32263a460ff8d4bdf4640fd793b5dd91c99362e0ab4fb061d56883b098f"
        },
        "note": {
          "text": "De enige vermelding. Auditoren die deze pagina bekijken met alle anderen.",
          "source_sha256": "798b1f9e9ea04bfa1c6659c64721f8815b75ba2675098db51230c52365c02e97"
        }
      },
      "1": {
        "label": {
          "text": "Lokale IAM-Verwaltung",
          "source_sha256": "5d77bb3f5103f030369432f842ff121b8ab21cc2d69e5dd79a20aa7179aa9863"
        },
        "note": {
          "text": "Zugriff en Identitaet → Verzeichnis → Lokale IAM-Verwaltung. Personen anlegen, Groups zuweisen en auditorbezogene Passwoerter zuruecksetzen (nur Leitung).",
          "source_sha256": "75b49694e5d112c4acf50c3b792aebc56f9a548d06e2dfda883b45072709baf3"
        }
      },
      "2": {
        "label": {
          "text": "Einschreibung en Zugriffskontrolle",
          "source_sha256": "2fd02dace2cb256f9260feb7e51309d8160f06046f526609060fe702defecb8a"
        },
        "note": {
          "text": "Zugriff en Identitaet → Verzeichnis → Einschreibung en Zugriffskontrolle. Zeigt the Einschreibungsvorgaben (alleen-lezen-beoordelaar, cmmc-beoordelaar, hoofdauditor).",
          "source_sha256": "2e359024689b8c7865948a854f3ed6e6b4a673554f932c26948deef54ebff429"
        }
      },
      "3": {
        "label": {
          "text": "Audit-opdrachten",
          "source_sha256": "dfcaba173519aee109c924095aa988b1a5824cad0057d441b2459f513227e23a"
        },
        "note": {
          "text": "Compliance → Audit-opdrachten. Auditoren einladen en de Engagement verwalten.",
          "source_sha256": "ce71519ef6836ac4b01029aa14780320240dab405ca9b79fee5693d12bdcacd8"
        }
      },
      "4": {
        "label": {
          "text": "Beoordelingsbinder",
          "source_sha256": "f6b38b0d06b1d601b62003ce6d3b5cb52447b4598bdb96151a213a9535b28d7f"
        },
        "note": {
          "text": "Naleving → Beoordelingsbinder. Steuerungsnarratief en Nachweise schreiben of pruefen.",
          "source_sha256": "16bbc2b7290931fd3763e95c32069cff700f89a87946c87919286fb0f9d02c66"
        }
      },
      "5": {
        "label": {
          "text": "Auditor-Handbuecher",
          "source_sha256": "8bda1a436adad4218135701588a04edb7c5cb1f413b55a5531046dd6fe94d69d"
        },
        "note": {
          "text": "Documentatie → Auditor-Handbuecher. Dieser Leitfaden en de Kapitel voor de Assessorarbeit.",
          "source_sha256": "b9e89deab82e7bffc02e6f434542ad9354d5e780cf9fb5af3c3b314eb1e85cf1"
        }
      }
    }
  },
  "user": {
    "title": {
      "text": "Benutzerhandbuecher",
      "source_sha256": "478c66ca22f7e69db87e0eda3d521688d81a4ee64a32ba777e2b531d98704b2a"
    },
    "intro": {
      "text": "Deze Kapitel richtte zich op sich an Personen, de sich anmelden, um zugewiesene Arbeitsplaetze, Sicheres Teilen en de eigene Konto to nutzen - geen Serveradministratoren. Volg de Schritten in de Produktoberflaeche. Als je een Steuerelement hebt, ga dan niet naar Ihrer Rolle.",
      "source_sha256": "98ee84c8d0b36172ea9656d05c3930ed33f17dd36fecf4a4025c1437ecdf203e"
    },
    "chapters": {
      "getting-started": {
        "title": {
          "text": "Erste Schritte",
          "source_sha256": "232c9caabcc362e9aed69a156811652b2a3bb01652709d6f9b5071c649ce2006"
        },
        "summary": {
          "text": "Melden, mijn Arbeitsplaetze oeffnen en een eerste vermittelte sessie starten.",
          "source_sha256": "1cd7cf2a56eb32e5d9f37b23ba0bda9dd18e75e2c92890c6becda523bdc14c17"
        }
      }
    }
  }
}
