  "adminAuthHelp": {
    "titleUnauthorized": {
      "text": "Beheerderverzoek afgewezen (401)",
      "source_sha256": "b8722d8b3d37dc48d99beb168b71efed46b018bf3f4d3d3b569c728fd9b178b3"
    },
    "titleManual": {
      "text": "Toegang tot beheerders-API",
      "source_sha256": "94be4815a1a196e33b7e69b001dd6ba94265a8332e8b073584b9c1695762b165"
    },
    "unauthorizedBody": {
      "text": "Eine geschuetzte Route unter /api/admin/ hat 401 Ongeautoriseerde zurueckgegeben. Als de IAM-Sitzungsauthentifizierung actief is, is uw aanmelding mogelijk - meld dit als er iets is gebeurd. Ohne Sitzungsauthentifizierung stimuleert de beheerder-melding van de browsers niet met de server gespeicherten ADMIN_TOKEN ueberein (z. B. nach een datenbank-reset of wenn nur een pagina van de paars geaendert wurde). Na het bestellen van de tokens zijn ze nieuw geladen of /login oeffnen, een nieuwe IAM-sessie is begonnen.",
      "source_sha256": "86b2f15818cdc9d35d6494986c9a88ec1482df5161f99214c7baeb261feea36d"
    },
    "quickFacts": {
      "text": "Kurzinfo's:",
      "source_sha256": "b4f3ee1eec63195b67a0f0c04ad39d32b3d6914dabab6c2dd0e996d9883dd1bc"
    },
    "oneNamePrimary": {
      "text": "Een naam: ADMIN_TOKEN",
      "source_sha256": "6a42766ea0badc1cf03bb537cfbfb7e0b24e47bf0ff161e97d93ce1f93902022"
    },
    "oneNameSecondary": {
      "text": "Het servermanifest bevat ADMIN_TOKEN. Deze browser heeft een Admin-Anfrage als HTTP-Header {{header}} (en X-Admin-Token voor andere builds). Als {{token}}, is de echte RBAC een stub ersetzt. Er zijn geen afzonderlijke registratienamen {{header}} — de naam is de Draht-Headername.",
      "source_sha256": "df1b4b1c08a9851f37953077abe6bebdef1b64d8377876b090959581adb6a89d"
    },
    "whereSecretsPrimary": {
      "text": "Wo the Server Geheimnisse speichert (Windows)",
      "source_sha256": "ba2eefc31e3b7c2dd8e9ff8799704ebf5339d403d147ede46a2c289d617658aa"
    },
    "whereSecretsSecondary": {
      "text": "Maschinenweite Instellingen liegen onder {{settings}} (bevorzugt) of {{settingsLegacy}} bij aelteren Installaties. Geheimnisse wie ADMIN_TOKEN liegen onder {{secrets}} (bevorzugt) of {{secretsLegacy}} als verschluesselte Registrierungswerte. Dienste als LocalSystem lesen deze Schluessel direkt. Windows Credential Manager-wird niet voor server- of agent-lauftijdgeheimen - deze wordt benut en voor dienstkonten niet verfuegbar.",
      "source_sha256": "0180a3a98eadcb44616957fbea4693cedd8796aa422cccb994d4a7c97d5a162b"
    },
    "unixPrimary": {
      "text": "Unix/macOS",
      "source_sha256": "eb22bccdb665389d79d6499dbc2f811c9995bc910b503f319caa453492fe5a84"
    },
    "unixSecondary": {
      "text": "Instellingen onder /etc/aic/ of /Library/Application Support/com.analoginfo/; Geheimen via de platformsleutelhanger (Linux Secret Service / macOS-sleutelhanger), niet als platte tekstbestanden.",
      "source_sha256": "ec2c7f1bade38336ca55f5f133b65480bc0b47ad8a420895abe8275e07b45268"
    },
    "iamPrimary": {
      "text": "IAM-sessieverificatie",
      "source_sha256": "3fac2c410424e741a8cb10e1af6d9bd075c0d90092ec1f310b70242098160d03"
    },
    "iamSecondary": {
      "text": "Als IAM_SESSION_AUTH_ENABLED is, is het een goede aanmelding (of de gemeinsamen ADMIN_TOKEN-header zonder gespeicherte sessie) erforderlich. Abgelaufene Sitzungstoken werden geloescht en de browser naar /login geschickt.",
      "source_sha256": "ed79e51dfec47ae9476ee58786336c2b198ee4c3d1ffc6b825ec5e7ef1eadb2c"
    },
    "operatorsFooter": {
      "text": "Voer deze in: bekijk docs/SECURITY.md en pim-app-config/docs/CONFIGURATION_STORAGE.md (HKLM-/Keyring-Layout).",
