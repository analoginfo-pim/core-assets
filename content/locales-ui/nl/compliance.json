  "explanations": {
    "cmmc": {
      "text": "CMMC (32 CFR 170) is een DoD-beoordelingspakket boven NIST SP 800-171 (en vanaf niveau 3 geselecteerde NIST SP 800-172-vereisten). Niveau 1: basis FCI-bescherming; Niveau 2: 110 800-171-praktijken voor CUI; Niveau 3: geavanceerde 800-172-vereisten. CMMC vervangt NIST SP 800-53 Rev. 5 niet als designvloer.",
      "source_sha256": "3cea730a3ae235201a8504ac9ae141ff29b230ec2a3a419403ef10435c0eb359"
    },
    "nist_800_171": {
      "text": "NIST SP 800-171 Rev. 2 definieert 110 beveiligingsvereisten in 14 families om CUI in niet-federale systemen te beschermen. Niveau 2 komt overeen met de oefenset van 110 (vaak met CMMC Niveau 2). Het productontwerp volgt nog steeds NIST SP 800-53 Rev. 5; 800-171 beoordeelt de verpakking erover.",
      "source_sha256": "7444d4520ad2ca1b06c2a66b03de41c54453fda41b6caafded746961a926df92"
    },
    "nist_800_172": {
      "text": "NIST SP 800-172 (februari 2021) voegt 35 uitgebreide vereisten toe naast 800-171. CMMC Fase 3 selecteert een subset. Onbewezen verbeterde claims blijven lacunes of onbekend.",
      "source_sha256": "65cf5967ecbb7d0b43d05a9c9a41be2f749dcf6c080cd5e6957f01e5dff8a584"
    },
    "nist_800_53": {
      "text": "NIST SP 800-53 Rev. 5 is de ontwerpvloer voor controles van dit product (gematigde basislijn, hoog indien van toepassing). CMMC / 800-171 / 800-172 zijn lagen die hetzelfde enclavebewijs gebruiken.",
      "source_sha256": "78e5f81c2759de85921f435bb9e498c40affd56902849f322ff4b11839669ef2"
    }
  },
