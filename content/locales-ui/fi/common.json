  "agentsDownload": {
    "title": {
      "text": "Agents-lataus",
      "source_sha256": "3005ea18d31ce72c8c4d8dda850f357416f9127710289ceb62ed6bbb9a85daea"
    },
    "intro": {
      "text": "Lataa tämän palvelimen Agents ja asetusiedostot. Agentin asentaminen ei sertifioi organisaatiota.",
      "source_sha256": "06eac51196802787cc39a17b1d78f1209f60696c4c39048693f26fd059e29789"
    },
    "inventoryPurpose": {
      "text": "Nämä Agents inventoivat paikat ja vahvistavat voimassa olevan CMMC-standardin edellyttämän tilan. Voimassa oleva standardi on määritetty toimintapaketti ({{package}}). Inventointi ja tilan vahvistus ovat tuotteen panos. Ne eivät ole Met, ne eivät sertifioi paikkaa eivätkä korvaa arvioijaa.",
      "source_sha256": "e46e25ee07d3c64e1de324a6a21c4d8b23781278bca06e3fb0ea6bc7ea6834ab"
    },
    "inventoryPurposeUnset": {
      "text": "Nämä Agents inventoivat paikat ja vahvistavat voimassa olevan CMMC-standardin edellyttämän tilan. Toimintapakettia ei ole asetettu. Valitse Asetuksissa L1 Fast, L2 Isolated, L3 Overlay tai NIST SP 800-53. Siihen asti Agents inventoivat paikkoja; tilan vahvistus noudattaa määrittämääsi pakettia. Inventointi ja tilan vahvistus ovat tuotteen panos. Ne eivät ole Met, ne eivät sertifioi paikkaa eivätkä korvaa arvioijaa.",
      "source_sha256": "85b08599fe45f8bee749857079830c53ec2ff16566d9330df72c04122bba63af"
    },
    "honesty": {
      "text": "Inventointi ja tilan vahvistus ovat tuotteen panos (Live tai Partial). Ne eivät ole Met, sertifioitu paikka eivätkä arvioijan korvike.",
      "source_sha256": "cab91b9871fd3af64d74f5bdb0f837b247b902de38895632ae09a4dfd80c35d0"
    },
    "settingsTitle": {
      "text": "Asetustiedosto",
      "source_sha256": "86e17bb7088eebff5046fb73546c3b464fac04fff87bce6f257d9e2c83cbf53e"
    },
    "settingsBody": {
      "text": "Asetustiedosto ei ole yleinen määritysluettelo. Se sisältää yksilöllistä salausaineistoa, joka aloittaa ensimmäisen suojatun yhteyden. Kun Agent rekisteröityy ja tekee ensimmäisen kirjautumisen, palvelin päivittää aineiston ja lähettää loput asetukset. Käyttöliittymä ei koskaan näytä yksityisiä avaimia, PIN-koodeja tai tunnuksia.",
      "source_sha256": "69975636ae30e0279cf912c9cf5c3f7ace1310c21c01c689acaf947213dbab4e"
    },
    "settingsWizard": {
      "text": "Avaa asetustoiminto ja luo asennusohjelmaa varten konettakohtainen yksilöllinen määritystiedosto.",
      "source_sha256": "9f9ccb91cc27289b8c88a3377b477a89440e68dd70352a37f2d89a089186113e"
    },
    "installersTitle": {
      "text": "Alustan asennusohjelmat",
