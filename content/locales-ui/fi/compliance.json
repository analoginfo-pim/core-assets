  "explanations": {
    "cmmc": {
      "text": "CMMC (32 CFR 170) on DoD-arviointipakkaus yli NIST SP 800-171:n (ja tasolta 3 valitut NIST SP 800-172 -vaatimukset). Taso 1: FCI-perussuojaus; Taso 2: 110 800-171 CUI-käytännöt; Taso 3: lisävaatimukset 800-172. CMMC ei korvaa NIST SP 800-53 Rev. 5:tä suunnittelulattiana.",
      "source_sha256": "3cea730a3ae235201a8504ac9ae141ff29b230ec2a3a419403ef10435c0eb359"
    },
    "nist_800_171": {
      "text": "NIST SP 800-171 Rev. 2 määrittelee 110 turvavaatimusta 14 perheessä CUI:n suojaamiseksi muissa kuin liittovaltion järjestelmissä. Taso 2 vastaa 110 harjoitussarjaa (usein CMMC Tasolla 2). Tuotesuunnittelussa noudatetaan edelleen NIST SP 800-53 Rev. 5; 800-171 arvioi pakkausta siitä.",
      "source_sha256": "7444d4520ad2ca1b06c2a66b03de41c54453fda41b6caafded746961a926df92"
    },
    "nist_800_172": {
      "text": "NIST SP 800-172 (helmikuu 2021) lisää 35 laajennettua vaatimusta 800-171:n lisäksi. CMMC Vaihe 3 valitsee osajoukon. Todistamattomat tehostetut väitteet ovat puutteita tai tuntemattomia.",
      "source_sha256": "65cf5967ecbb7d0b43d05a9c9a41be2f749dcf6c080cd5e6957f01e5dff8a584"
    },
    "nist_800_53": {
      "text": "NIST SP 800-53 Rev. 5 on tämän tuotteen kontrollien suunnittelun alaraja (kohtalainen perustaso, korkea tarvittaessa). CMMC / 800-171 / 800-172 ovat kerroksia, jotka käyttävät samaa enklaavin näyttöä.",
      "source_sha256": "78e5f81c2759de85921f435bb9e498c40affd56902849f322ff4b11839669ef2"
    }
  },
