    "root": {
      "bullets": [
        {
          "text": "Puuttuvat ruudut näyttävät \"Ei vielä saatavilla\" — ei koskaan keksittyä nollaa.",
          "source_sha256": "945a6ac23ca5db7eb374d90f3244c553a499d159100a0cad5f39b45279d21f17"
        },
        {
          "text": "Osittaiset ruudut merkitään \"Osittainen\"-tilaan selkokielisellä syyllä.",
          "source_sha256": "fd61988cb65ff1900dcb19623ad5f378c4707699c45af971eb7e2cd4f6971572"
        },
        {
          "text": "Mukauta Siirrä ylös / Siirrä alas -toiminnoilla. Organisaation oletuksen julkaisu edellyttää dashboard.publish; henkilökohtainen tallennus edellyttää dashboard.personalize.",
          "source_sha256": "ed93d51a2d8fe95be8fa4f5d53187a952a0d3fbec97b23f05c6cc8b83d49a31c"
        },
        {
          "text": "Omat työasemat tai Salasanan näyttö ovat Suosikeissa.",
          "source_sha256": "89193a25b206956414b2a74329b269c4c161cf119fc2548531a8850c6a47e02f"
        },
        {
          "text": "Ilman dashboard.view-oikeutta tällä sivulla ei ole näytettävää, joten sinut ohjataan Suosikkeihin.",
          "source_sha256": "be0c280be23979edd80969ca5452046ca2159abbce0e457710061fa4d1314d1a"
        }
      ],
      "title": {
