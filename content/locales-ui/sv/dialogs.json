  "adminAuthHelp": {
    "titleUnauthorized": {
      "text": "Administrator request denied (401)",
      "source_sha256": "b8722d8b3d37dc48d99beb168b71efed46b018bf3f4d3d3b569c728fd9b178b3"
    },
    "titleManual": {
      "text": "Admin API access",
      "source_sha256": "94be4815a1a196e33b7e69b001dd6ba94265a8332e8b073584b9c1695762b165"
    },
    "unauthorizedBody": {
      "text": "A protected route at /api/admin/ returned 401 Unauthorized. If IAM session authentication is active, your login is usually expired — log in again. Without session authentication, the browser's administrative login secret does not match the ADMIN_TOKEN stored on the server (e.g. after a database reset or when only one side of the pair was changed). After correcting the token, hard reload or open /login to establish a new IAM session.",
      "source_sha256": "041b6f1655b35a81efdfa78f4b5903983dbc1529d06562b716ad82826463df96"
    },
    "quickFacts": {
      "text": "Quick facts:",
      "source_sha256": "34b49dd74fe116122d2b22134721810ae25decdd9103709cf833b6fe3a7e8204"
    },
    "oneNamePrimary": {
      "text": "One name: ADMIN_TOKEN",
      "source_sha256": "5eb3b2ed3c69991253061d3be88ff3e7ef00351e89fa60507dd8cdd63a93b146"
    },
    "oneNameSecondary": {
      "text": "The server manifest secret is called ADMIN_TOKEN. This browser appends it to every admin request as HTTP header {{header}} (and X-Admin token for older builds). Value {{token}} until real RBAC replaces this stub. There is no separate registry value called {{header}} — that is just the wire header name.",
      "source_sha256": "4f48f0046f99ef619410e3f0fdf81033c69619ac329d68e9f800e21427dc7db0"
    },
    "whereSecretsPrimary": {
      "text": "Where the server stores secrets (Windows)",
      "source_sha256": "c02e33018aca6395745a856e07ac19d8b46bd97b0e9bffce47506db8d169292a"
    },
    "whereSecretsSecondary": {
      "text": "Machine-wide settings live under {{settings}} (preferred) or {{settingsLegacy}} on older installs. Secrets such as ADMIN_TOKEN live under {{secrets}} (preferred) or {{secretsLegacy}} as encrypted registry values. Services running as LocalSystem read these keys directly. Windows Credential Manager is not used for server or agent runtime secrets — it is per-user and unavailable to service accounts.",
      "source_sha256": "a58e912f42d67e598017536e2aa27004ca4fe4dfa91e7190bd8055ff4f39b334"
    },
    "unixPrimary": {
      "text": "Unix / macOS",
      "source_sha256": "eb22bccdb665389d79d6499dbc2f811c9995bc910b503f319caa453492fe5a84"
    },
    "unixSecondary": {
      "text": "Settings under /etc/aic/ or /Library/Application Support/com.analoginfo/; Secrets via the platform keyring (Linux Secret Service / macOS Keychain), not as plain text files.",
      "source_sha256": "ec2c7f1bade38336ca55f5f133b65480bc0b47ad8a420895abe8275e07b45268"
    },
    "iamPrimary": {
      "text": "IAM session authentication",
      "source_sha256": "3fac2c410424e741a8cb10e1af6d9bd075c0d90092ec1f310b70242098160d03"
    },
    "iamSecondary": {
      "text": "When IAM_SESSION_AUTH_ENABLED is true, a valid sign-in (or the shared ADMIN_TOKEN header without a stored session) is required. Expired session tokens are cleared and the browser is sent to /login.",
      "source_sha256": "0904aebd275408f683ea2f8f3f9bc7cb9a29289b17db12a6976ec3ff636a06d8"
    },
    "operatorsFooter": {
      "text": "For operators: see docs/SECURITY.md and pim-app-config/docs/CONFIGURATION_STORAGE.md (HKLM/Keyring layout).",
      "source_sha256": "be1698d02534b1c7ef91dd333276b084f9b619d78ce8fa210d883b9124687fbe"
