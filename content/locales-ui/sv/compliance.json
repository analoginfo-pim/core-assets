  "explanations": {
    "cmmc": {
      "text": "CMMC (32 CFR 170) är DoD-bedömningspaket över NIST SP 800-171 (och från nivå 3 valda NIST SP 800-172 krav). Nivå 1: grundläggande FCI-skydd; Nivå 2: 110 800-171 Praxis för CUI; Nivå 3: avancerade 800-172 krav. CMMC ersätter inte NIST SP 800-53 Rev. 5 som designgolv.",
      "source_sha256": "3cea730a3ae235201a8504ac9ae141ff29b230ec2a3a419403ef10435c0eb359"
    },
    "nist_800_171": {
      "text": "NIST SP 800-171 Rev. 2 definierar 110 säkerhetskrav i 14 familjer för att skydda CUI i icke-federala system. Nivå 2 motsvarar övningssetet 110 (ofta med CMMC Nivå 2). Produktdesignen fortsätter att följa NIST SP 800-53 Rev. 5; 800-171 betygsätter förpackningar om det.",
      "source_sha256": "7444d4520ad2ca1b06c2a66b03de41c54453fda41b6caafded746961a926df92"
    },
    "nist_800_172": {
      "text": "NIST SP 800-172 (feb. 2021) lägger till 35 utökade krav utöver 800-171. CMMC Steg 3 väljer en delmängd. Obevisade förbättrade påståenden förblir luckor eller okända.",
      "source_sha256": "65cf5967ecbb7d0b43d05a9c9a41be2f749dcf6c080cd5e6957f01e5dff8a584"
    },
    "nist_800_53": {
      "text": "NIST SP 800-53 Rev. 5 är golvet för kontrollutformning i den här produkten (måttlig baslinje, hög om tillämpligt). CMMC / 800-171 / 800-172 är överlagringar som använder samma enklaverbevis.",
      "source_sha256": "78e5f81c2759de85921f435bb9e498c40affd56902849f322ff4b11839669ef2"
    }
  },
