    "oneNamePrimary": {
      "text": "Ein名称：ADMIN_TOKEN",
      "source_sha256": "6a42766ea0badc1cf03bb537cfbfb7e0b24e47bf0ff161e97d93ce1f93902022"
    },
    "oneNameSecondary": {
      "text": "服务器清单包含 ADMIN_TOKEN。 Dieser 浏览器具有一个 jede Admin-Anfrage 和 HTTP-Header {{header}}（以及用于 aeltere 版本的 X-Admin-Token）。 Wert {{token}}，是 RBAC 的缩写。 Es gibt keinen alone Registrierungswert namens {{header}} — 是 Draht-Headername 的名称。",
      "source_sha256": "df1b4b1c08a9851f37953077abe6bebdef1b64d8377876b090959581adb6a89d"
    },
    "whereSecretsPrimary": {
      "text": "服务器 Geheimnisse speichert (Windows)",
      "source_sha256": "ba2eefc31e3b7c2dd8e9ff8799704ebf5339d403d147ede46a2c289d617658aa"
    },
    "whereSecretsSecondary": {
      "text": "Maschinenweite 设置位于 {{settings}} (bevorzugt) 或 {{settingsLegacy}} bei aelteren Installationen 下。 Geheimnisse wie ADMIN_TOKEN liegen under {{secrets}} (bevorzugt) 或 {{secretsLegacy}} als verschluesselte Registrierungswerte。 LocalSystem 是由 Schluessel 直接指定的。 Windows 凭据管理器不适用于服务器或代理Laufzeitgeheimnisse genutzt — es ist benutzerbezogen 并且适用于Dienstkonten 而非verfuegbar。",
      "source_sha256": "0180a3a98eadcb44616957fbea4693cedd8796aa422cccb994d4a7c97d5a162b"
    },
    "unixPrimary": {
      "text": "Unix/macOS",
      "source_sha256": "eb22bccdb665389d79d6499dbc2f811c9995bc910b503f319caa453492fe5a84"
    },
    "unixSecondary": {
      "text": "/etc/aic/ 或 /Library/Application Support/com.analoginfo/ 下的设置； Geheimnisse ueber the Plattform-Keyring (Linux Secret Service / macOS Keychain)，而不是 Klartextdateien。",
      "source_sha256": "85f4f0ce310d449dc6381e75d16df35ff7e8a511b3d0d3f8f571f4f300318985"
    },
    "iamPrimary": {
