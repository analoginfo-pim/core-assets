    "iamSecondary": {
      "text": "Wenn IAM_SESSION_AUTH_ENABLED wahr ist, ist a gueltige Sign-in (or the gemeinsamen ADMIN_TOKEN-Header without gespeicherte Session) erforderlich. Abgelaufene Sitzungstoken werden geloescht 和浏览器 /login geschickt。",
      "source_sha256": "ed79e51dfec47ae9476ee58786336c2b198ee4c3d1ffc6b825ec5e7ef1eadb2c"
    },
    "operatorsFooter": {
