    "root": {
      "bullets": [
        {
          "text": "Brakujące kafelki pokazują „Jeszcze niedostępne” — nigdy wymyślonego zera.",
          "source_sha256": "945a6ac23ca5db7eb374d90f3244c553a499d159100a0cad5f39b45279d21f17"
        },
        {
          "text": "Częściowe kafelki są oznaczone jako „Częściowe” z prostym uzasadnieniem.",
          "source_sha256": "fd61988cb65ff1900dcb19623ad5f378c4707699c45af971eb7e2cd4f6971572"
        },
        {
          "text": "Dostosuj za pomocą Przenieś w górę / w dół. Opublikowanie domyślnego ustawienia organizacji wymaga dashboard.publish; zapis osobisty wymaga dashboard.personalize.",
          "source_sha256": "ed93d51a2d8fe95be8fa4f5d53187a952a0d3fbec97b23f05c6cc8b83d49a31c"
        },
        {
          "text": "Moje stacje robocze lub Pokaż hasło znajdują się w Ulubionych.",
          "source_sha256": "89193a25b206956414b2a74329b269c4c161cf119fc2548531a8850c6a47e02f"
        },
        {
          "text": "Bez dashboard.view ta strona nie ma nic do pokazania, więc trafiasz do Ulubionych.",
          "source_sha256": "be0c280be23979edd80969ca5452046ca2159abbce0e457710061fa4d1314d1a"
        }
      ],
      "title": {
        "text": "Pulpit",
        "source_sha256": "67b696468610b879ed7f224dbf6b0861f27e39d20454cb9d7af1ec52d3e5eeaa"
      }
    }
