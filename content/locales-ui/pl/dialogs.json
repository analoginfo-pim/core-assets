  "adminAuthHelp": {
    "titleUnauthorized": {
      "text": "Abgelehnt administratora (401)",
      "source_sha256": "aff72ace4c9c96e04f0608e70a43200d19caf51749482d0eb35ee05fd33fc48b"
    },
    "titleManual": {
      "text": "Dostęp do interfejsu API administratora",
      "source_sha256": "94be4815a1a196e33b7e69b001dd6ba94265a8332e8b073584b9c1695762b165"
    },
    "unauthorizedBody": {
      "text": "Chroniona trasa w /api/admin/ zwróciła 401 Nieautoryzowana. Jeśli uwierzytelnianie sesji IAM jest aktywne, Twój login zwykle wygasł — zaloguj się ponownie. Bez uwierzytelnienia sesji, administracyjny sekret logowania przeglądarki nie jest zgodny z ADMIN_TOKEN przechowywanym na serwerze (np. po resecie bazy danych lub gdy zmieniono tylko jedną stronę pary). Po poprawieniu tokena należy załadować ponownie lub otworzyć /zalogować się, aby nawiązać nową sesję IAM.",
      "source_sha256": "041b6f1655b35a81efdfa78f4b5903983dbc1529d06562b716ad82826463df96"
    },
    "quickFacts": {
      "text": "Informacje Kurz:",
      "source_sha256": "b4f3ee1eec63195b67a0f0c04ad39d32b3d6914dabab6c2dd0e996d9883dd1bc"
    },
    "oneNamePrimary": {
      "text": "Nazwa użytkownika: ADMIN_TOKEN",
      "source_sha256": "6a42766ea0badc1cf03bb537cfbfb7e0b24e47bf0ff161e97d93ce1f93902022"
    },
    "oneNameSecondary": {
      "text": "Sekret manifestu serwera nosi nazwę ADMIN_TOKEN. Ta przeglądarka dołącza go do każdego żądania administratora jako nagłówek HTTP {{header}} (oraz token X-Admin w przypadku starszych wersji). Wartość {{token}}, dopóki prawdziwy RBAC nie zastąpi tego odcinka. Nie ma osobnej wartości rejestru o nazwie {{header}} — jest to po prostu nazwa nagłówka przewodu.",
      "source_sha256": "4f48f0046f99ef619410e3f0fdf81033c69619ac329d68e9f800e21427dc7db0"
    },
    "whereSecretsPrimary": {
      "text": "Wo the Server Geheimnisse speichert (Windows)",
      "source_sha256": "ba2eefc31e3b7c2dd8e9ff8799704ebf5339d403d147ede46a2c289d617658aa"
    },
    "whereSecretsSecondary": {
      "text": "Ustawienia Maschinenweite leżą pod {{settings}} (bevorzugt) lub {{settingsLegacy}} bei aelteren Installationen. Geheimnisse wie ADMIN_TOKEN Liegen unter {{secrets}} (bevorzugt) lub {{secretsLegacy}} als verschluesselte Registrierungswerte. Dienste als LocalSystem lesen diese Schluessel direkt. Menedżer poświadczeń systemu Windows nie jest przeznaczony dla serwera lub agenta-Laufzeitgeheimnisse genutzt — jest ist benutzerbezogen, a dla Dienstkonten nie jest verfuegbar.",
      "source_sha256": "0180a3a98eadcb44616957fbea4693cedd8796aa422cccb994d4a7c97d5a162b"
    },
    "unixPrimary": {
      "text": "Unix/macOS",
      "source_sha256": "eb22bccdb665389d79d6499dbc2f811c9995bc910b503f319caa453492fe5a84"
    },
    "unixSecondary": {
      "text": "Ustawienia w /etc/aic/ lub /Library/Application Support/com.analoginfo/; Geheimnisse używa platformy-breloków (Linux Secret Service / macOS Keychain), a nie Klartextdateien.",
      "source_sha256": "85f4f0ce310d449dc6381e75d16df35ff7e8a511b3d0d3f8f571f4f300318985"
    },
    "iamPrimary": {
      "text": "IAM-Sitzungsauthentifizierung",
      "source_sha256": "bdc9c9abf4cb87bcb0fb6ac8c3e8f8f8e7bfbe4877f23c09b0018fed1ec59cbb"
    },
    "iamSecondary": {
      "text": "Wenn IAM_SESSION_AUTH_ENABLED wahr ist, ist gueltige Sign-in (lub gemeinsamen ADMIN_TOKEN-Header bez gespeicherte Session) erforderlich. Abgelaufene Sitzungstoken werden geloescht i przeglądarkę na /login geschickt.",
      "source_sha256": "ed79e51dfec47ae9476ee58786336c2b198ee4c3d1ffc6b825ec5e7ef1eadb2c"
    },
    "operatorsFooter": {
      "text": "Więcej opcji: siehe docs/SECURITY.md i pim-app-config/docs/CONFIGURATION_STORAGE.md (HKLM-/Keyring-Layout).",
