  "explanations": {
    "cmmc": {
      "text": "CMMC (32 CFR 170) to pakiet oceny DoD dotyczący NIST SP 800-171 (i wybranych wymagań NIST SP 800-172 z poziomu 3). Poziom 1: podstawowa ochrona FCI; Poziom 2: 110 800-171 Praktyki dla CUI; Poziom 3: zaawansowane wymagania 800-172. CMMC nie zastępuje NIST SP 800-53 Rev. 5 jako podłoga projektowa.",
      "source_sha256": "3cea730a3ae235201a8504ac9ae141ff29b230ec2a3a419403ef10435c0eb359"
    },
    "nist_800_171": {
      "text": "NIST SP 800-171 Rev. 2 definiuje 110 wymagań bezpieczeństwa w 14 rodzinach w celu ochrony CUI w systemach innych niż federalne. Poziom 2 odpowiada zestawowi ćwiczeń 110 (często z CMMC Poziomem 2). Projekt produktu jest nadal zgodny z NIST SP 800-53 Rev. 5; 800-171 ocenia opakowanie na ten temat.",
      "source_sha256": "7444d4520ad2ca1b06c2a66b03de41c54453fda41b6caafded746961a926df92"
    },
    "nist_800_172": {
      "text": "NIST SP 800-172 (luty 2021 r.) dodaje 35 rozszerzonych wymagań poza 800-171. CMMC Etap 3 wybiera podzbiór. Nieudowodnione, ulepszone twierdzenia pozostają lukami lub są nieznane.",
      "source_sha256": "65cf5967ecbb7d0b43d05a9c9a41be2f749dcf6c080cd5e6957f01e5dff8a584"
    },
    "nist_800_53": {
      "text": "NIST SP 800-53 Rev. 5 jest dolną granicą projektu kontroli tego produktu (linia bazowa umiarkowana, wysoka jeśli dotyczy). CMMC / 800-171 / 800-172 to nakładki używające tych samych dowodów enklawy.",
      "source_sha256": "78e5f81c2759de85921f435bb9e498c40affd56902849f322ff4b11839669ef2"
    }
  },
