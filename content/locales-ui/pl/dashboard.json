  "honestyNotes": {
    "env": {
      "systems_count": {
        "text": "Liczba zarejestrowanych systemów enklawy w tej chwili. Linie trendu używają historii próbkowanej; przed pierwszą próbką seria jest pusta, a historia zaczyna się od tej próbki. Nie procent pokrycia i nie wniosek z oceny.",
        "source_sha256": "69db030a51534b9f1c94b4fc22caa29a357b0ec4f5103a77832e90ae82f4f420"
      },
      "probe_enabled_count": {
        "text": "Ile zarejestrowanych systemów ma obecnie włączone probing. Linie trendu używają historii próbkowanej; puste do pierwszej próbki. Włączone probing nie jest dowodem, że kontrola przeszła.",
        "source_sha256": "6b4019cc538d7e6452bba4d7e522f9a461163c02db6bc0e7aef58edcb84d3619"
      },
      "physical_vs_log": {
        "text": "Podział najnowszych wierszy dowodów oznaczonych physical_host versus log_derived. Linie trendu używają historii próbkowanej; puste do pierwszej próbki. Tylko skład zebranych dowodów — nie wskaźnik zdawalności.",
        "source_sha256": "2855f98debf6941663aedc64b7d515611ce8065d6126f3bbbefb7e54e93d7710"
      },
      "punch_list_open": {
        "text": "Otwarte ustalenia i częściowe wyniki z najnowszych dowodów floty. Zalegałość dostawy dla operatorów — nie wynik ryzyka rezydualnego. Linie trendu używają historii próbkowanej; puste do pierwszej próbki.",
        "source_sha256": "892e38b032e917ebc3e1f700df18c4531b2fbb56c67a8f4992a3738468d7531f"
      },
      "discovered_systems": {
        "text": "Zarejestrowane systemy, których tożsamość pochodzi z discovery (import / skan / katalog). Linie trendu używają historii próbkowanej tej liczby pochodzenia rejestracji; puste do pierwszej próbki — nigdy nie wymyślaj punktów przedhistorii.",
        "source_sha256": "de19ba275f78d499fb3efa2f0526d1449bffa600d502c0b7de15f1102c865e6c"
      }
    },
    "training": {
      "framework_coverage": {
        "text": "Covered oznacza, że istnieje dokument szkoleniowy cytujący klauzulę tego standardu. Nie oznacza, że ktoś przeczytał dokument, i nie jest oceną kontroli. Linie trendu używają historii próbkowanej; puste do pierwszej próbki.",
        "source_sha256": "a8be8f3e73b4b91f364a40d87d643ac04e08d3ab20383238fef47a64d8ad5a15"
      },
      "uncovered_frameworks": {
        "text": "Frameworki, które zobowiązują do świadomości personelu, ale nie mają jeszcze dokumentu pokrywającego w bibliotece. Luka dokumentowa — nie ustalenie, że personel jest niewyszkolony. Linie trendu używają historii próbkowanej; puste do pierwszej próbki.",
        "source_sha256": "784464ec9f7d460d2ca6834bb60f8c8ae28c5bbd2684625a205de9d1d7481aa2"
      }
    },
    "compliance": {
      "pack_readiness": {
        "text": "Liczby rodzin Report Center w stanach dostawy available, partial, planned lub blocked. Gotowość kolektorów produktu — nigdy werdykt CMMC ani FedRAMP. Linie trendu używają historii próbkowanej; puste do pierwszej próbki.",
        "source_sha256": "9beb070ca0de42316f2835009cf5f98bb8253d564e55ed2cd3c21c5ae8400f8c"
      },
      "poam_open": {
        "text": "Liczba wierszy POA&M ze statusem open, in_progress lub deferred. Śledzi zarejestrowaną pracę naprawczą — nie czy ekspozycja jest akceptowalna. Linie trendu używają historii próbkowanej; puste do pierwszej próbki.",
        "source_sha256": "5a896b5deb083d047b45798d2968c20f5eb14923a05d1ca423b64f19e8aacf4b"
      },
      "attestations_recorded": {
        "text": "Liczba wierszy w offline_compliance_attestations, których attested_at przypada w wybranym oknie 7/30/90 dni (domyślnie 30). Dowód, że zapisano rekordy attestacji — nie że każda wymagana attestacja jest ukończona.",
        "source_sha256": "a54857fb8f45e50b3e5423ad1825b8e6d061f9ba89707a729577c5494235ac68"
      }
    },
    "pum": {
      "violations_24h": {
        "text": "Zdarzenia naruszeń privileged-use management zarejestrowane w ostatnich 24 godzinach przy każdej próbce. Linie trendu używają tej historii próbkowanej w wybranym oknie 7/30/90; puste do pierwszej próbki. Nie wynik ważności.",
        "source_sha256": "fa97fb2f5cb07cc43edb78acfb4d18d6c15c5742f59f234b75f96d508ac3d0dd"
      },
      "endpoints_enrolled": {
        "text": "Punkty końcowe z przypisaniem polityki PUM w tej chwili. Linie trendu używają historii próbkowanej; puste do pierwszej próbki. Tylko liczba rejestracji — nie jakość egzekwowania.",
        "source_sha256": "f9782cd71f65e67c68227b52dc200d793849ce54eec82bf92c9fb6ba0a12e5af"
      }
    },
    "ir": {
      "open_cases": {
        "text": "Liczba spraw IR ze statusem open lub processing, których opened_at przypada w wybranym oknie 7/30/90 dni (domyślnie 30). Zalegałość obciążenia z offline_ir_cases — nie ocena, że reagowanie na incydenty jest skuteczne. Wykresy liniowe nie mają dziennej historii, dopóki nie pojawi się sampler metryk; pusta seria jest jawna, nie sfabrykowany zerowy trend.",
        "source_sha256": "a91e296ab260af632c2660d7067801347d7cb3d18e92e1c86b64fbbb0322ca49"
      },
      "cases_opened_closed": {
        "text": "Sprawy z opened_at lub closed_at w wybranym oknie 7/30/90 dni (domyślnie 30), z offline_ir_cases. Przepustowość zarejestrowanej pracy spraw — nie jakość odpowiedzi ani skuteczność kontroli.",
        "source_sha256": "7ade5f268580015310b250936cd9867ca900607fa7ef4c9eadd204b93f29b9fc"
      }
    },
    "defense": {
      "blocked_attempts": {
        "text": "Nieudane i odrzucone logowania oraz zablokowane żądania API w wybranym oknie 7/30/90 dni. Tylko liczby odrzuconych prób — nie twierdzenie, że atakujący uruchomili polecenia lub że przechwycono złośliwe oprogramowanie. Otwiera stronę Zablokowane ataki.",
        "source_sha256": "142c4df58a904c676ac11691195f2c9b92b506f8e5540446b4fdd8c680f23543"
      }
    },
    "events": {
      "by_type": {
        "text": "Liczby z bieżącego bufora pierścieniowego zdarzeń w procesie. Nie trwała historia i nie trend 7/30/90 — rozmiar bufora ogranicza to, co widzisz.",
        "source_sha256": "260d7582bad3557747bfacc83be9d06e2fef0f3134c76d6fefe9a4a79c6bb527"
      }
    }
  },
