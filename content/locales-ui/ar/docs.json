    "configLinks": {
      "0": {
        "label": {
          "text": "يسجل",
          "source_sha256": "bb7234ec12451361e6f35bcbe76de58e4350657fe60d1b96ace0947f59194083"
        },
        "note": {
          "text": "صفحة تسجيل الدخول الوحيدة. يستخدم المدققون هذا الموقع مثل أي شخص آخر.",
          "source_sha256": "7c1772680987eb0810879683657437c5ca711dca2eb24ad4b44bfdd1d75c4754"
        }
      },
      "1": {
        "label": {
          "text": "إدارة IAM المحلية",
          "source_sha256": "996527dea286c5955c0e95ef37c3a5be2e6cf9b772b74f3df13f167ce4fd2040"
        },
        "note": {
          "text": "الوصول والهوية → الدليل → إدارة IAM المحلية. إنشاء أشخاص وتعيين مجموعات وإعادة تعيين كلمات المرور المتعلقة بالمدقق (السطر فقط).",
          "source_sha256": "9fec7d41b1ecc877bdbc95218fd2220dfcb81730be30f0719906f0e3aa95b907"
        }
      },
      "2": {
        "label": {
          "text": "أينشريبونغ وزوغريفسكونترول",
          "source_sha256": "2fd02dace2cb256f9260feb7e51309d8160f06046f526609060fe702defecb8a"
        },
        "note": {
          "text": "الوصول والهوية → الدليل → التسجيل والتحكم في الوصول. يعرض متطلبات التسجيل (مقيم للقراءة فقط، مقيم CMMC، مدقق رئيسي).",
          "source_sha256": "182512ee39ef91dc376dd76adb5d4b99c82cbe71ff84211e6e899c3b1d2eb1fd"
        }
      },
      "3": {
        "label": {
          "text": "ارتباطات التدقيق",
          "source_sha256": "dfcaba173519aee109c924095aa988b1a5824cad0057d441b2459f513227e23a"
        },
        "note": {
          "text": "الامتثال → التدقيق-التعاقدات. Auditoren einladen and the Engagement verwalten.",
          "source_sha256": "ce71519ef6836ac4b01029aa14780320240dab405ca9b79fee5693d12bdcacd8"
        }
      },
      "4": {
        "label": {
          "text": "رابط التقييم",
          "source_sha256": "edce73881ba543a19ed06b9eaee2c7998fb127db9bf6232dc805423bed35f519"
        },
        "note": {
          "text": "الامتثال → مجلد التقييم. كتابة أو مراجعة الروايات والأدلة السيطرة.",
          "source_sha256": "2c3766e276c7ceb65823e60fef8c3f696b83ae8a15b98085b5bcaa9bcc368bfb"
        }
      },
      "5": {
        "label": {
          "text": "أدلة المراجعين",
          "source_sha256": "6623ff55741761694cc60ea3e767301b9c1d248b65de5f46d388d0c9a1d9ab56"
        },
        "note": {
          "text": "التوثيق ← دليل المدقق. هذا الدليل والفصل الخاص بعمل المُقيّم.",
          "source_sha256": "218f342d87adcb72b661780061dfce0382379c7c642c9a66df95da067d50faa7"
        }
      }
    }
  },
  "user": {
    "title": {
      "text": "أدلة المستخدم",
      "source_sha256": "2725143e17ddf246ae9bd7d5021e8a286f190113c21fa46f2d74cb7c786ccbc6"
    },
    "intro": {
      "text": "هذه الفصول مخصصة للأشخاص الذين يقومون بتسجيل الدخول لاستخدام المقاعد المخصصة والمشاركة الآمنة وحسابهم الخاص - وليس مسؤولي الخادم. اتبع الخطوات الموجودة في واجهة المنتج. إذا كان عنصر التحكم مفقودًا، فهو ليس جزءًا من دورك.",
      "source_sha256": "ec1313dbc64c939dffa51a096b84aaee53e954cb3bd206f0535f89e2a76a306f"
    },
    "chapters": {
      "getting-started": {
        "title": {
          "text": "إرستي شريت",
          "source_sha256": "232c9caabcc362e9aed69a156811652b2a3bb01652709d6f9b5071c649ce2006"
        },
        "summary": {
          "text": "قم بتسجيل الدخول، وافتح محطات العمل الخاصة بي وابدأ جلسة الوساطة الأولى.",
          "source_sha256": "1596626afc90c4adf6ca7d904cef542b6de88e0fff737bca78504710693ee5d8"
        },
        "body[0]": {
          "text": "يعرض AIC Server صفحة تسجيل الدخول في المتصفح. استخدم الهوية التي قدمتها لك مؤسستك (الحساب المحلي أو الدليل). إذا كان الموقع يتطلب مصادقة متعددة العوامل، فأكملها قبل توقع ضوابط مكان العمل.",
          "source_sha256": "0680e640f10998cd727c657066edcee92a722167ba8e31802c97cf108778ab92"
        },
        "body[1]": {
          "text": "تسرد أماكن العمل الخاصة بي الأجهزة المخصصة لك. لا يمكنك اختراع الوصول إلى مضيف غير موجود في هذه القائمة — اطلب من المسؤول تعيينه بدلاً من إعادة المحاولة بلا نهاية.",
          "source_sha256": "0220bae51ce71a2ce0a7d5cabf268ffcce5f4c9c869516b7f75a4c621477cf41"
        },
        "steps[0]": {
          "text": "قم بتسجيل الدخول وإكمال MFA عندما يُطلب منك ذلك.",
          "source_sha256": "e12c6650d3d92c8f5c82ca707cb6acda7c81761835bae59a6308fee3c3c4f991"
        },
        "steps[1]": {
          "text": "افتح مساحات العمل الخاصة بي في شريط التنقل الرئيسي.",
          "source_sha256": "b8166bcb4db08369728119d95d4804a4ac6678867d68ac3b9f254af3b9c1a9c4"
        },
        "steps[2]": {
          "text": "حدد محطة عمل معينة وابدأ ميسر الجلسة.",
          "source_sha256": "7567a3b116cef57725e22990ed16699950e95ad15cd5b4546488b844d96acc05"
        },
        "steps[3]": {
          "text": "اضغط على Geoeffnet لعلامة تبويب المتصفح، واضبط بداية الجلسة. أغلق Sie ihn erst nach the Trennen.",
          "source_sha256": "5b0f4c1d183230872859ea82d34f3c2080af5711f9896f59957b770c92b23a0d"
        },
        "steps[4]": {
          "text": "إذا كان الجهاز مفقودًا، فاتصل بالمسؤول بدلاً من مشاركة الجلسة مع شخص آخر.",
          "source_sha256": "f3d0ab1bab6e75bb95f1179e9ce26366e8061f15a4c96dd2033e4dea34a9ff95"
        },
        "productLabel": {
          "text": "افتح محطات العمل الخاصة بي",
          "source_sha256": "6f66350b625fd314d5314665d2b3bc132efe66e7c596e10c2aa5136e49372ca4"
        }
      },
      "my-workstations": {
        "title": {
          "text": "محطات العمل الخاصة بي في الاستخدام اليومي",
          "source_sha256": "a1b4fb5a6e9624a2f3a6fe252f48e2add42c5baf05d7924a710acdde8b74cbf1"
        },
        "summary": {
          "text": "Energiezustand، erneutes Connect and the Vorgehen، wenn a Host schlaeft.",
          "source_sha256": "63ad9e4dc69ae289f371f92f94bdacb0850c8d67ee1e6427b1ecbd3a2e899a90"
        },
        "body[0]": {
          "text": "Ein- وAufwecksteuerungen gelten nur لـ Ihnen zugewiesene Maschinen. Schlafende أو Zustaende غير متصل بالإنترنت بشكل طبيعي، عندما يكون المضيف ausgeschaltet ist. Warten Sie auf the Aufwecken أو fragen Sie a Admin، bevor Sie wiederholt neu ver suchen.",
          "source_sha256": "6e28429879e643758984cfeef03e390323e0d1dc426116ccb50f7ae46de528a8"
        },
        "body[1]": {
          "text": "قم بإنهاء الجلسات في الوسيط عند الانتهاء حتى يمكن إغلاق وقت الخمول وتسجيل الجلسة بشكل نظيف. لا تشارك تذاكر الجلسة أو الروابط لمرة واحدة خارج واجهة المنتج.",
          "source_sha256": "f051906594b38b28a5445245cf4fe00d1b2060d09208a0ab558098a9f659b13a"
        },
        "steps[0]": {
          "text": "استخدم عناصر التحكم في التشغيل أو التنبيه المعروضة للأجهزة المخصصة لك فقط.",
          "source_sha256": "2034be5fd85fcbdbde152eb481037722c9af70f959c7280c3c2d338073b74217"
        },
        "steps[1]": {
          "text": "Zeigt the Status schlafend أو غير متصل بالإنترنت، warten Sie kurz و fragen Sie a Admin، wenn the Zustand bleibt.",
          "source_sha256": "21814b8d8777ec791e56538b597e3b6112064bda0950ace12d72a2532b41bed4"
        },
        "steps[2]": {
          "text": "Beenden Sie the Session in the Vermittler، wenn Sie Fertig Sind.",
          "source_sha256": "a928a0f0864148c7651b10d817e1b6de5993f53276851ad7033906be1409dbc4"
        },
        "steps[3]": {
          "text": "Fuegen Sie Sitzungs-URLs niemals في الدردشة أو البريد الإلكتروني أ.",
          "source_sha256": "76141efae53b83608509d67e93e7f0119357495bafcaae8e71b947554a57e980"
        },
        "productLabel": {
          "text": "افتح محطات العمل الخاصة بي",
          "source_sha256": "6f66350b625fd314d5314665d2b3bc132efe66e7c596e10c2aa5136e49372ca4"
        }
      },
      "secure-share": {
        "title": {
          "text": "Sicheres Teilen لـ Endbenutzer",
          "source_sha256": "5c1f7312ba9b044f4b5b92a0f0b6258c293a033a68abba7cc1f7808cbbefa06f"
        },
        "summary": {
          "text": "تلقي وفتح العناصر المشتركة دون حقوق المسؤول.",
          "source_sha256": "95d6950ec4fa15ad0ca477a004d29ac69bb6c95daeaa5f11974dd8557699d9dd"
        },
        "body[0]": {
          "text": "تظهر المشاركة الآمنة إذا كان دورك يسمح بذلك. يتم فتح الحزم الموجهة إليك في عارض المنتج. لا يمكن التنزيل إلا إذا كانت سياسة الحزمة تسمح بذلك.",
          "source_sha256": "aed73c6645aee111e84a12c77c16607138b408189933c54d9a60e092d0f5783b"
        },
        "body[1]": {
          "text": "تعامل مع الإصدارات غير المتوقعة باعتبارها مشكلة دعم: قم بإبلاغ المسؤول عنها. لا تقم بإعادة توجيه الروابط لمرة واحدة.",
          "source_sha256": "b5997371072b282baa3ded90e47d8230d6b26ad65000e131afd46c38b46e77f2"
        },
        "steps[0]": {
          "text": "افتح المشاركة الآمنة في قائمة المستخدم إذا كانت متوفرة.",
          "source_sha256": "0bf74bf24cf13e250d09bdd05b17472ece71d9d832ced8a1820acf37a57123a6"
        },
        "steps[1]": {
          "text": "اقبل الطرود الموجهة إليك وافتحها في العارض.",
          "source_sha256": "40bfcfcab5646f9079e9ec5572259904c4c664cf63f1890dd867c78928eaa5f3"
        },
        "steps[2]": {
          "text": "جارٍ التحميل فقط، عندما تكون الحزمة متاحة.",
          "source_sha256": "4cc1e31fea7a6a51974f80a72769a486c791184e8be45fb7e5ef998aecd6fc6b"
        },
        "steps[3]": {
          "text": "قم بالإبلاغ عن الإصدارات غير المتوقعة إلى المسؤول لديك.",
          "source_sha256": "fb0508e594a86b06eb1ff4522ea1c3f0df57fb6a7bbf099845c2ad55db7091af"
        },
        "productLabel": {
          "text": "افتح المشاركة الآمنة",
          "source_sha256": "12c57ff5edcda34212a786b86db31d9f30f92d3efc3a9f7867de47368806cf2a"
        }
      },
      "account": {
        "title": {
          "text": "مين lokales كونتو",
          "source_sha256": "34b705251f341711def5cd5db46beb3ba25b8ff692ee11f82d07a255847f7097"
        },
        "summary": {
          "text": "الملف الشخصي وكلمة المرور والخدمة الذاتية MFA.",
          "source_sha256": "70313b51825740746b2e7a8b630224d6293ff8f4d284ce6906e90aef2c7a8228"
        },
        "body[0]": {
          "text": "تحتوي صفحة ملفك الشخصي على أسماء العرض ومعلومات الاتصال. تتبع تغييرات كلمة المرور سياسة الطول والتاريخ الخاصة بالمؤسسة. يتم تسجيل موثقي MFA أو استبدالهم عندما تطالبك صفحة الأمان بذلك.",
          "source_sha256": "fd19565202ac719ba3ee1f8810c0fc651f1da12620aa1cba3edf4c543906a157"
        },
        "body[1]": {
          "text": "من وحدة التحكم المشتركة، قم بتسجيل الخروج عند الانتهاء حتى لا يتولى الشخص التالي إدارة جلستك.",
          "source_sha256": "ee77eb077224bf187d1e3831fd29ed43b584278e2662fa94ba2025182978d4c6"
        },
        "steps[0]": {
          "text": "قم بتحديث اسم العرض ومعلومات الاتصال الخاصة بك على صفحة ملفك الشخصي.",
          "source_sha256": "f8985e663990c633d0b13df54488eb885ef790fcc3a49a54e2ec740c78c09bf5"
        },
        "steps[1]": {
          "text": "قم بتغيير كلمة المرور من خلال عملية أمان الحساب.",
          "source_sha256": "ba6476d58bd25ceb03864505acea5d973aee3f00352405a88ddad193b487fbb3"
        },
        "steps[2]": {
          "text": "قم بتسجيل أو استبدال مصدقي MFA إذا كان مسموحًا لك بذلك.",
          "source_sha256": "ec8f785c0fea903a7e983941062d260be336cf413117e6cfe31ee66411d1c35a"
        },
        "steps[3]": {
          "text": "قم بتسجيل الخروج من وحدات التحكم المشتركة عند الانتهاء.",
          "source_sha256": "461b07c137e01f8a67bf48a059be853e84f5013a2d5875fd46025657e5442873"
        },
        "productLabel": {
          "text": "فتح ملف تعريف الحساب",
          "source_sha256": "1ed2c576b7d0f4a053e5191fcaff4bb96c54c75629db2a441df100c53d8a95e9"
        }
      },
      "get-help": {
        "title": {
          "text": "Wenn etwas fehlschlaegt",
          "source_sha256": "f43efc94bca5d08e18172241cfa0ebf56e2ce0ebde6e9826d2c0bdcb3445196d"
        },
        "summary": {
          "text": "ما يجب تسجيله قبل الاتصال بالمسؤول.",
          "source_sha256": "52426d82062a2544ef9070c5d2a588628fa67623fd920f66e35d12cf16b30300"
        },
        "body[0]": {
          "text": "قم بتسجيل عنوان URL للصفحة والوقت بما في ذلك المنطقة الزمنية ونص الخطأ الدقيق. إن إعادة المحاولة لفترة قصيرة بعد فترة انتظار أمر منطقي. النقر المتكرر لا يتجاوز قرارات الوصول.",
          "source_sha256": "b41a524e67fe73dfee5828c4790a86a6ac7913b08d6dee7c50a4fceec5017ae9"
        },
        "body[1]": {
          "text": "لا تقم أبدًا بتضمين كلمات المرور أو رموز الاسترداد أو رموز الارتفاع في الدردشة أو التذاكر أ. اطلب من المسؤول ربط التدقيق إذا كنت بحاجة إلى دليل رسمي.",
          "source_sha256": "276713d39c04da4fc54416eeea69a59b59e0166401981fd08d07975469370c07"
        },
        "steps[0]": {
          "text": "Notieren Sie URL، Uhrzeit (مع Zeitzone) وFehlertext.",
          "source_sha256": "3477401d201dce8a786c09d9f961c6aaa9046ffa129bb26922073f94b56dc33d"
        }
      }
    }
  }
}
