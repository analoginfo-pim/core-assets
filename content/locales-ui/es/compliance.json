  "explanations": {
    "cmmc": {
      "text": "CMMC (32 CFR 170) es un paquete de evaluación del Departamento de Defensa sobre NIST SP 800-171 (y del nivel 3, requisitos seleccionados de NIST SP 800-172). Nivel 1: protección básica FCI; Nivel 2: 110 800-171 Prácticas para CUI; Nivel 3: requisitos avanzados 800-172. CMMC no reemplaza a NIST SP 800-53 Rev. 5 como piso de diseño.",
      "source_sha256": "3cea730a3ae235201a8504ac9ae141ff29b230ec2a3a419403ef10435c0eb359"
    },
    "nist_800_171": {
      "text": "NIST SP 800-171 Rev. 2 define 110 requisitos de seguridad en 14 familias para proteger CUI en sistemas no federales. El nivel 2 corresponde al conjunto de práctica 110 (a menudo con CMMC Nivel 2). El diseño del producto sigue NIST SP 800-53 Rev. 5; 800-171 está calificando el embalaje al respecto.",
      "source_sha256": "7444d4520ad2ca1b06c2a66b03de41c54453fda41b6caafded746961a926df92"
    },
    "nist_800_172": {
      "text": "NIST SP 800-172 (febrero de 2021) agrega 35 requisitos ampliados más allá de 800-171. CMMC La etapa 3 selecciona un subconjunto. Las afirmaciones mejoradas no probadas siguen siendo vacías o desconocidas.",
      "source_sha256": "65cf5967ecbb7d0b43d05a9c9a41be2f749dcf6c080cd5e6957f01e5dff8a584"
    },
    "nist_800_53": {
      "text": "NIST SP 800-53 Rev. 5 es el piso de diseño de controles de este producto (línea base moderada, alta si corresponde). CMMC / 800-171 / 800-172 son superposiciones que usan la misma evidencia del enclave.",
      "source_sha256": "78e5f81c2759de85921f435bb9e498c40affd56902849f322ff4b11839669ef2"
    }
  },
