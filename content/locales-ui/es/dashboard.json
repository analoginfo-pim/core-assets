  "honestyNotes": {
    "env": {
      "systems_count": {
        "text": "Recuento de sistemas de enclave inscritos en este momento. Las tendencias usan historial muestreado; antes de la primera muestra la serie está vacía y el historial comienza en esa muestra. No es un porcentaje de cobertura ni una conclusión de evaluación.",
        "source_sha256": "69db030a51534b9f1c94b4fc22caa29a357b0ec4f5103a77832e90ae82f4f420"
      },
      "probe_enabled_count": {
        "text": "Cuántos sistemas inscritos tienen el sondeo activado en este momento. Las tendencias usan historial muestreado; vacías hasta la primera muestra. El sondeo habilitado no es evidencia de que un control haya pasado.",
        "source_sha256": "6b4019cc538d7e6452bba4d7e522f9a461163c02db6bc0e7aef58edcb84d3619"
      },
      "physical_vs_log": {
        "text": "División de las últimas filas de evidencia etiquetadas physical_host versus log_derived. Las tendencias usan historial muestreado; vacías hasta la primera muestra. Composición de la evidencia recopilada únicamente — no una tasa de aprobación.",
        "source_sha256": "2855f98debf6941663aedc64b7d515611ce8065d6126f3bbbefb7e54e93d7710"
      },
      "punch_list_open": {
        "text": "Hallazgos abiertos y resultados parciales de la evidencia más reciente de la flota. Atraso de entrega para operadores — no una puntuación de riesgo residual. Las tendencias usan historial muestreado; vacías hasta la primera muestra.",
        "source_sha256": "892e38b032e917ebc3e1f700df18c4531b2fbb56c67a8f4992a3738468d7531f"
      },
      "discovered_systems": {
        "text": "Sistemas inscritos cuya identidad proviene del descubrimiento (importación / análisis / directorio). Las tendencias usan historial muestreado de ese recuento de origen de inscripción; vacías hasta la primera muestra — nunca inventar puntos de prehistoria.",
        "source_sha256": "de19ba275f78d499fb3efa2f0526d1449bffa600d502c0b7de15f1102c865e6c"
      }
    },
    "training": {
      "framework_coverage": {
        "text": "Cubierto significa que existe un documento de formación y cita una cláusula de esa norma. No significa que alguien haya leído el documento, y no es una evaluación de control. Las tendencias usan historial muestreado; vacías hasta la primera muestra.",
        "source_sha256": "a8be8f3e73b4b91f364a40d87d643ac04e08d3ab20383238fef47a64d8ad5a15"
      },
      "uncovered_frameworks": {
        "text": "Marcos que exigen concienciación de la fuerza laboral pero aún no tienen un documento de cobertura en la biblioteca. Una brecha documental — no un hallazgo de que el personal no está formado. Las tendencias usan historial muestreado; vacías hasta la primera muestra.",
        "source_sha256": "784464ec9f7d460d2ca6834bb60f8c8ae28c5bbd2684625a205de9d1d7481aa2"
      }
    },
    "compliance": {
      "pack_readiness": {
        "text": "Recuentos de familias del Centro de informes en estados de entrega available, partial, planned o blocked. Preparación de los recolectores del producto — nunca un veredicto CMMC o FedRAMP. Las tendencias usan historial muestreado; vacías hasta la primera muestra.",
        "source_sha256": "9beb070ca0de42316f2835009cf5f98bb8253d564e55ed2cd3c21c5ae8400f8c"
      },
      "poam_open": {
        "text": "Recuento de filas POA&M en estado open, in_progress o deferred. Rastrea el trabajo de remediación registrado — no si la exposición es aceptable. Las tendencias usan historial muestreado; vacías hasta la primera muestra.",
        "source_sha256": "5a896b5deb083d047b45798d2968c20f5eb14923a05d1ca423b64f19e8aacf4b"
      },
      "attestations_recorded": {
        "text": "Recuento de filas en offline_compliance_attestations cuyo attested_at cae en la ventana de 7/30/90 días seleccionada (predeterminado 30). Prueba de que se escribieron registros de atestación — no de que cada atestación requerida esté hecha.",
        "source_sha256": "a54857fb8f45e50b3e5423ad1825b8e6d061f9ba89707a729577c5494235ac68"
      }
    },
    "pum": {
      "violations_24h": {
        "text": "Eventos de violación de gestión de uso privilegiado registrados en las últimas 24 horas en cada muestra. Las tendencias usan ese historial muestreado en la ventana 7/30/90 seleccionada; vacías hasta la primera muestra. No es una puntuación de gravedad.",
        "source_sha256": "fa97fb2f5cb07cc43edb78acfb4d18d6c15c5742f59f234b75f96d508ac3d0dd"
      },
      "endpoints_enrolled": {
        "text": "Extremos con una asignación de política PUM en este momento. Las tendencias usan historial muestreado; vacías hasta la primera muestra. Recuento de inscripción únicamente — no la calidad de aplicación.",
        "source_sha256": "f9782cd71f65e67c68227b52dc200d793849ce54eec82bf92c9fb6ba0a12e5af"
      }
    },
    "ir": {
      "open_cases": {
        "text": "Recuento de casos IR con estado open o processing cuyo opened_at cae en la ventana de 7/30/90 días seleccionada (predeterminado 30). Atraso de carga desde offline_ir_cases — no un juicio de que la respuesta a incidentes sea eficaz. Los gráficos de líneas no tienen historial diario hasta que llegue el muestreo de métricas; una serie vacía es explícita, no una tendencia cero fabricada.",
        "source_sha256": "a91e296ab260af632c2660d7067801347d7cb3d18e92e1c86b64fbbb0322ca49"
      },
      "cases_opened_closed": {
        "text": "Casos con opened_at o closed_at dentro de la ventana de 7/30/90 días seleccionada (predeterminado 30), desde offline_ir_cases. Rendimiento del trabajo de casos registrado — no la calidad de la respuesta ni la eficacia del control.",
        "source_sha256": "7ade5f268580015310b250936cd9867ca900607fa7ef4c9eadd204b93f29b9fc"
      }
    },
    "defense": {
      "blocked_attempts": {
        "text": "Inicios de sesión fallidos y denegados más solicitudes API bloqueadas en la ventana de 7/30/90 días seleccionada. Recuentos solo de intentos denegados — no una afirmación de que los atacantes ejecutaron comandos o de que se capturó malware. Abre la página Ataques bloqueados.",
        "source_sha256": "142c4df58a904c676ac11691195f2c9b92b506f8e5540446b4fdd8c680f23543"
      }
    },
    "events": {
      "by_type": {
        "text": "Recuentos del búfer de eventos en proceso en este momento. No es historial duradero ni una tendencia 7/30/90 — el tamaño del búfer limita lo que ve.",
        "source_sha256": "260d7582bad3557747bfacc83be9d06e2fef0f3134c76d6fefe9a4a79c6bb527"
      }
    }
  },
