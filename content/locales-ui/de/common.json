  "agentsDownload": {
    "title": {
      "text": "Agents-Download",
      "source_sha256": "3005ea18d31ce72c8c4d8dda850f357416f9127710289ceb62ed6bbb9a85daea"
    },
    "intro": {
      "text": "Laden Sie Agents und Einstellungsdateien für diese AIC-Server-Instanz herunter. CMMC in a Box ist das integrierte Werkzeugset. Die Installation eines Agents zertifiziert die Organisation nicht.",
      "source_sha256": "c5fd2edb9a21131fa70db1725d8ecb11f6118682f0bc2f7eac2ded429cbd2ada"
    },
    "inventoryPurpose": {
      "text": "Diese Agents erfassen Sitze und prüfen den erforderlichen Zustand für den geltenden CMMC-Standard. Der geltende Standard ist das konfigurierte Betriebspaket ({{package}}). Bestandserfassung und Zustandsprüfung sind ein Produktbeitrag. Sie sind nicht Met, zertifizieren keinen Sitz und ersetzen den Prüfer nicht.",
      "source_sha256": "e46e25ee07d3c64e1de324a6a21c4d8b23781278bca06e3fb0ea6bc7ea6834ab"
    },
    "inventoryPurposeUnset": {
      "text": "Diese Agents erfassen Sitze und prüfen den erforderlichen Zustand für den geltenden CMMC-Standard. Das Betriebspaket ist nicht gesetzt. Wählen Sie in den Einstellungen L1 Fast, L2 Isolated, L3 Overlay oder NIST SP 800-53. Bis dahin erfassen Agents weiterhin Sitze; die Zustandsprüfung folgt dem von Ihnen festgelegten Paket. Bestandserfassung und Zustandsprüfung sind ein Produktbeitrag. Sie sind nicht Met, zertifizieren keinen Sitz und ersetzen den Prüfer nicht.",
      "source_sha256": "85b08599fe45f8bee749857079830c53ec2ff16566d9330df72c04122bba63af"
    },
    "honesty": {
      "text": "Bestandserfassung und Zustandsprüfung sind ein Produktbeitrag (Live oder Partial). Sie sind nicht Met, kein zertifizierter Sitz und kein Ersatz für den Prüfer.",
      "source_sha256": "cab91b9871fd3af64d74f5bdb0f837b247b902de38895632ae09a4dfd80c35d0"
    },
    "settingsTitle": {
      "text": "Einstellungsdatei",
      "source_sha256": "86e17bb7088eebff5046fb73546c3b464fac04fff87bce6f257d9e2c83cbf53e"
    },
    "settingsBody": {
      "text": "Die Einstellungsdatei ist keine allgemeine Konfigurationsliste. Sie enthält einzigartiges kryptografisches Material, das die erste sichere Verbindung startet. Nach der Registrierung und der ersten Anmeldung aktualisiert der Server dieses Material und überträgt die übrigen Einstellungen. Die Benutzeroberfläche zeigt niemals private Schlüssel, PINs oder Token.",
      "source_sha256": "69975636ae30e0279cf912c9cf5c3f7ace1310c21c01c689acaf947213dbab4e"
    },
    "settingsWizard": {
      "text": "Öffnen Sie den Einstellungsassistenten, um eine eindeutige Konfigurationsdatei je Maschine für den Installer zu erzeugen.",
      "source_sha256": "9f9ccb91cc27289b8c88a3377b477a89440e68dd70352a37f2d89a089186113e"
    },
    "installersTitle": {
      "text": "Plattform-Installer",
      "source_sha256": "5dd3ea5ea2b9670dca57655553e1c9f90bb829bdc748a29d19757c1991a50539"
    },
    "installersHelp": {
      "text": "Jede Zeile ist ein auslieferbarer Installer, den diese Instanz bereitstellen kann. Version und SHA-256 stammen von der Datei auf dem Datenträger. Fehlende Plattformen bleiben gesperrt. Dieser Server erfindet keine Binärdateien und keine Hashes.",
      "source_sha256": "e6805ec131175421b1a17b01dd5fb54c3beec6bebc4b07a72163fa9bcc8fd591"
    },
    "colVersion": {
      "text": "Version",
      "source_sha256": "dd167905de0defcaf72de673ee44c07431770d129ccffab286bd2edfdaf62396"
    },
    "download": {
      "text": "Herunterladen",
      "source_sha256": "d6eafe82359100423c93c5ce53c352c1b51ca1e699215fcec3f5c5dd9bf12d24"
    },
    "downloadFailed": {
      "text": "Dieser Installer konnte nicht heruntergeladen werden. Prüfen Sie, ob die Datei noch im Instanzverzeichnis liegt, und versuchen Sie es erneut.",
      "source_sha256": "413dae048671e5fe19cedff9bd23cc84f7174dcaab0451d6dc852f27a7d8f072"
    },
    "blocked": {
      "text": "Gesperrt — keine Datei auf dieser Instanz",
      "source_sha256": "bc4a7878833b14d878f4211b26a42c66588a336b1777ce2c56f9cb1d3a777358"
    },
    "retry": {
      "text": "Erneut versuchen",
      "source_sha256": "942087cc2d41e01304b7195558d093d10c72af8e838c7556d6a02d471ee71852"
    },
    "loadFailed": {
      "text": "Der Agents-Download-Katalog konnte nicht geladen werden.",
      "source_sha256": "569f771e918f1b075a791ea64ca22939f0aeaf7bb16926fce5a47b64eb5a6408"
    },
    "whereTitle": {
      "text": "Wo Agents erscheinen",
      "source_sha256": "684a0c5bedf219062fd9b7ec97295855d4a4cf9dc70a71cbe1c1cb9fd2d0beda"
    },
    "whereBody": {
      "text": "Nach der Anmeldung erscheinen Sitze unter Systeme, Flotten-Agent-Versionen und Workstation Assurance. Erhöhung und Aufzeichnung nutzen den Agent, der bereits auf dem Sitz ist. Diese Seiten zeigen den Lieferzustand, nicht Met.",
      "source_sha256": "52a92e8ab6759a00c26e0e0176c4aeea3f4eab12220fae3efd630cd12f344134"
    },
    "whyTitle": {
      "text": "Warum Agents erforderlich sind",
      "source_sha256": "f5eaa11a201043085b090aef19a251d61c89b07067406e70182387b351a5ef0e"
    },
    "whyBody": {
      "text": "Agents liefern Endpunktpräsenz, Anmeldung, Bestand und Zustandsnachweise für das geltende Betriebspaket. Das ist ein Werkzeugbeitrag. Das bedeutet nicht, dass die Organisation eine Bewertung bestanden hat.",
      "source_sha256": "7b8a9efa155870c4a0136513245b066ca23c51082347120813b9e0a78a68a8b7"
    },
