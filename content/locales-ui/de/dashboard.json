  "honestyNotes": {
    "defense.blocked_attempts": {
      "text": "Fehlgeschlagene und abgelehnte Anmeldungen sowie blockierte API-Anfragen im gewählten Fenster von 7/30/90 Tagen. Nur abgelehnte Versuche — kein Beleg, dass Angreifer Befehle ausgeführt oder Schadsoftware hinterlassen haben. Öffnet die Seite Blockierte Angriffe.",
      "source_sha256": "142c4df58a904c676ac11691195f2c9b92b506f8e5540446b4fdd8c680f23543"
    },
    "env.systems_count": {
      "text": "Anzahl der derzeit registrierten Enclave-Systeme. Trendlinien nutzen die Stichprobenhistorie; vor der ersten Stichprobe ist die Reihe leer und die Historie beginnt mit dieser Stichprobe. Kein Abdeckungsgrad und kein Bewertungsergebnis.",
      "source_sha256": "69db030a51534b9f1c94b4fc22caa29a357b0ec4f5103a77832e90ae82f4f420"
    },
    "env.probe_enabled_count": {
      "text": "Wie viele registrierte Systeme haben derzeit die Sondierung aktiviert. Trendlinien nutzen die Stichprobenhistorie; leer bis zur ersten Stichprobe. Aktivierte Sondierung ist kein Nachweis, dass eine Kontrolle bestanden wurde.",
      "source_sha256": "6b4019cc538d7e6452bba4d7e522f9a461163c02db6bc0e7aef58edcb84d3619"
    },
    "env.physical_vs_log": {
      "text": "Aufteilung der neuesten Nachweise mit Kennzeichnung physical_host gegenüber log_derived. Trendlinien nutzen die Stichprobenhistorie; leer bis zur ersten Stichprobe. Nur Zusammensetzung der erfassten Nachweise — keine Bestehensquote.",
      "source_sha256": "2855f98debf6941663aedc64b7d515611ce8065d6126f3bbbefb7e54e93d7710"
    },
    "training.framework_coverage": {
      "text": "Abgedeckt bedeutet, dass ein Schulungsdokument vorliegt und eine Klausel dieses Standards zitiert. Es bedeutet nicht, dass jemand das Dokument gelesen hat, und ist keine Kontrollbewertung. Trendlinien nutzen die Stichprobenhistorie; leer bis zur ersten Stichprobe.",
      "source_sha256": "a8be8f3e73b4b91f364a40d87d643ac04e08d3ab20383238fef47a64d8ad5a15"
    },
    "compliance.pack_readiness": {
      "text": "Anzahl der Report-Center-Familien in den Lieferzuständen verfügbar, teilweise, geplant oder blockiert. Bereitschaft der Produktsammler — niemals ein CMMC- oder FedRAMP-Urteil. Trendlinien nutzen die Stichprobenhistorie; leer bis zur ersten Stichprobe.",
      "source_sha256": "9beb070ca0de42316f2835009cf5f98bb8253d564e55ed2cd3c21c5ae8400f8c"
    },
    "env.punch_list_open": {
      "text": "Offene Feststellungen und teilweise Ergebnisse aus dem neuesten Flottennachweis. Lieferrückstand für Betreiber — kein Restrisiko-Score. Trendlinien nutzen die Stichprobenhistorie; leer bis zur ersten Stichprobe.",
      "source_sha256": "892e38b032e917ebc3e1f700df18c4531b2fbb56c67a8f4992a3738468d7531f"
    },
    "compliance.poam_open": {
      "text": "Anzahl der POA&M-Zeilen mit Status offen, in Bearbeitung oder zurückgestellt. Verfolgt dokumentierte Abhilfemaßnahmen — nicht, ob die Exposition akzeptabel ist. Trendlinien nutzen die Stichprobenhistorie; leer bis zur ersten Stichprobe.",
      "source_sha256": "5a896b5deb083d047b45798d2968c20f5eb14923a05d1ca423b64f19e8aacf4b"
    },
    "pum.violations_24h": {
      "text": "Ereignisse zu Verstößen gegen die Privilegiennutzung (PUM), die in den letzten 24 Stunden je Stichprobe erfasst wurden. Trendlinien nutzen diese Stichprobenhistorie über das gewählte Fenster 7/30/90; leer bis zur ersten Stichprobe. Kein Schweregrad-Score.",
      "source_sha256": "fa97fb2f5cb07cc43edb78acfb4d18d6c15c5742f59f234b75f96d508ac3d0dd"
    },
    "training.uncovered_frameworks": {
      "text": "Frameworks, die eine Sensibilisierung der Belegschaft verlangen, für die aber noch kein abdeckendes Dokument in der Bibliothek vorliegt. Eine Dokumentenlücke — kein Befund, dass Personen ungeschult sind. Trendlinien nutzen die Stichprobenhistorie; leer bis zur ersten Stichprobe.",
      "source_sha256": "784464ec9f7d460d2ca6834bb60f8c8ae28c5bbd2684625a205de9d1d7481aa2"
    },
    "ir.open_cases": {
      "text": "Anzahl der IR-Fälle mit Status offen oder in Bearbeitung, deren opened_at in das gewählte Fenster von 7/30/90 Tagen fällt (Standard 30). Arbeitsrückstand aus offline_ir_cases — kein Urteil über die Wirksamkeit der Vorfallreaktion. Liniendiagramme haben keine tägliche Historie, bis der Metrik-Sampler verfügbar ist; eine leere Reihe ist ausdrücklich, kein erfundener Nulltrend.",
      "source_sha256": "a91e296ab260af632c2660d7067801347d7cb3d18e92e1c86b64fbbb0322ca49"
    },
    "ir.cases_opened_closed": {
      "text": "Fälle mit opened_at oder closed_at innerhalb des gewählten Fensters von 7/30/90 Tagen (Standard 30), aus offline_ir_cases. Durchsatz der erfassten Fallarbeit — nicht Antwortqualität oder Kontrollwirksamkeit.",
      "source_sha256": "7ade5f268580015310b250936cd9867ca900607fa7ef4c9eadd204b93f29b9fc"
    },
    "events.by_type": {
      "text": "Zählungen aus dem prozessinternen Ereignis-Ringpuffer im Moment. Keine dauerhafte Historie und kein 7/30/90-Trend — die Puffergröße begrenzt, was Sie sehen.",
      "source_sha256": "260d7582bad3557747bfacc83be9d06e2fef0f3134c76d6fefe9a4a79c6bb527"
    },
    "pum.endpoints_enrolled": {
      "text": "Endpunkte mit einer PUM-Richtlinienzuweisung in diesem Moment. Trendlinien nutzen die Stichprobenhistorie; leer bis zur ersten Stichprobe. Nur Registrierungsanzahl — keine Durchsetzungsqualität.",
      "source_sha256": "f9782cd71f65e67c68227b52dc200d793849ce54eec82bf92c9fb6ba0a12e5af"
    },
    "env.discovered_systems": {
      "text": "Registrierte Systeme, deren Identität aus der Entdeckung stammt (Import / Scan / Verzeichnis). Trendlinien nutzen die Stichprobenhistorie dieser Herkunftszählung; leer bis zur ersten Stichprobe — niemals vorhistorische Punkte erfinden.",
      "source_sha256": "de19ba275f78d499fb3efa2f0526d1449bffa600d502c0b7de15f1102c865e6c"
