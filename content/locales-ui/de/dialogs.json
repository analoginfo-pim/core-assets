  "adminAuthHelp": {
    "titleUnauthorized": {
      "text": "Administratoranfrage abgelehnt (401)",
      "source_sha256": ""
    },
    "titleManual": {
      "text": "Administrator-API-Zugriff",
      "source_sha256": ""
    },
    "unauthorizedBody": {
      "text": "Eine geschützte Route unter /api/admin/ hat 401 Unauthorized zurückgegeben. Wenn die IAM-Sitzungsauthentifizierung aktiv ist, ist Ihre Anmeldung meist abgelaufen — melden Sie sich erneut an. Ohne Sitzungsauthentifizierung stimmt das Administrator-Anmeldegeheimnis des Browsers nicht mit dem auf dem Server gespeicherten ADMIN_TOKEN überein (z. B. nach einem Datenbank-Reset oder wenn nur eine Seite des Paars geändert wurde). Nach dem Korrigieren des Tokens hart neu laden oder /login öffnen, um eine neue IAM-Sitzung aufzubauen.",
      "source_sha256": ""
    },
    "quickFacts": {
      "text": "Kurzinfos:",
      "source_sha256": ""
    },
    "oneNamePrimary": {
      "text": "Ein Name: ADMIN_TOKEN",
      "source_sha256": ""
    },
    "oneNameSecondary": {
      "text": "Das Server-Manifestgeheimnis heißt ADMIN_TOKEN. Dieser Browser hängt es an jede Admin-Anfrage als HTTP-Header {{header}} (und X-Admin-Token für ältere Builds). Wert {{token}}, bis echte RBAC diesen Stub ersetzt. Es gibt keinen separaten Registrierungswert namens {{header}} — das ist nur der Draht-Headername.",
      "source_sha256": ""
    },
    "whereSecretsPrimary": {
      "text": "Wo der Server Geheimnisse speichert (Windows)",
      "source_sha256": ""
    },
    "whereSecretsSecondary": {
      "text": "Maschinenweite Einstellungen liegen unter {{settings}} (bevorzugt) oder {{settingsLegacy}} bei älteren Installationen. Geheimnisse wie ADMIN_TOKEN liegen unter {{secrets}} (bevorzugt) oder {{secretsLegacy}} als verschlüsselte Registrierungswerte. Dienste als LocalSystem lesen diese Schlüssel direkt. Windows Credential Manager wird nicht für Server- oder Agent-Laufzeitgeheimnisse genutzt — es ist benutzerbezogen und für Dienstkonten nicht verfügbar.",
      "source_sha256": ""
    },
    "unixPrimary": {
      "text": "Unix / macOS",
      "source_sha256": ""
    },
    "unixSecondary": {
      "text": "Einstellungen unter /etc/aic/ oder /Library/Application Support/com.analoginfo/; Geheimnisse über den Plattform-Keyring (Linux Secret Service / macOS Keychain), nicht als Klartextdateien.",
      "source_sha256": ""
    },
    "iamPrimary": {
      "text": "IAM-Sitzungsauthentifizierung",
      "source_sha256": ""
    },
    "iamSecondary": {
      "text": "Wenn IAM_SESSION_AUTH_ENABLED wahr ist, ist eine gültige Anmeldung (oder die gemeinsamen ADMIN_TOKEN-Header ohne gespeicherte Sitzung) erforderlich. Abgelaufene Sitzungstoken werden gelöscht und der Browser zu /login geschickt.",
      "source_sha256": ""
    },
